<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bảng điều khiển quản lý — L'Amour Bookstore</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy-900:#0A1930;
    --navy-800:#0F2444;
    --navy-700:#173461;
    --navy-500:#2E5590;
    --navy-100:#EEF2F8;
    --cream:#FAF7F1;
    --paper:#FFFFFF;
    --gold:#C7A15A;
    --gold-dark:#9C7C3B;
    --gold-100:#FBF3E3;
    --danger:#B5533C;
    --danger-100:#FBEDE8;
    --success:#2E7D32;
    --success-100:#E8F5E9;
    --ink:#12203A;
    --muted:#5C6B85;
    --line:#E4DFD3;
    --shadow-soft:0 20px 40px -20px rgba(10,25,48,0.25);
    --shadow-card:0 10px 24px -14px rgba(10,25,48,0.28);
    --sidebar-w:250px;
  }

  *,*::before,*::after{ box-sizing:border-box; }
  body{
    margin:0; background:var(--cream); color:var(--ink);
    font-family:'Inter',sans-serif; -webkit-font-smoothing:antialiased;
  }
  a{ color:inherit; text-decoration:none; }
  button{ font-family:inherit; cursor:pointer; }
  ul{ list-style:none; margin:0; padding:0; }
  h1,h2,h3{ font-family:'Fraunces',serif; margin:0; color:var(--navy-900); }
  :focus-visible{ outline:2px solid var(--gold); outline-offset:2px; }
  .eyebrow{
    font-family:'IBM Plex Mono',monospace; text-transform:uppercase;
    letter-spacing:.14em; font-size:11px; font-weight:600; color:var(--gold-dark);
  }
  .mono{ font-family:'IBM Plex Mono',monospace; }

  .perforation{ display:flex; align-items:center; gap:6px; margin:22px 0 28px; }
  .perforation span{ width:5px; height:5px; border-radius:50%; background:var(--line); flex:0 0 auto; }
  .perforation .rule{ flex:1 1 auto; height:1px; background:var(--line); }

  /* ============ APP SHELL ============ */
  .app{ display:grid; grid-template-columns:var(--sidebar-w) 1fr; min-height:100vh; }

  /* ============ SIDEBAR ============ */
  .sidebar{
    background:var(--navy-900); color:#C7D1E3;
    display:flex; flex-direction:column;
    padding:26px 18px; position:sticky; top:0; height:100vh;
  }
  .brand{ display:flex; align-items:center; gap:10px; padding:0 6px 24px; }
  .brand .mark{
    width:34px; height:34px; border-radius:8px; flex:0 0 auto;
    background:linear-gradient(150deg,var(--gold),var(--gold-dark));
    color:var(--navy-900); font-family:'Fraunces',serif; font-weight:600; font-size:15px;
    display:flex; align-items:center; justify-content:center;
  }
  .brand .txt .name{ font-family:'Fraunces',serif; font-size:16px; color:#fff; line-height:1.1; }
  .brand .txt .tag{ font-family:'IBM Plex Mono',monospace; font-size:9px; letter-spacing:.18em; text-transform:uppercase; color:#8DA0C4; margin-top:2px; }

  .admin-mini{
    display:flex; align-items:center; gap:12px;
    background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.08);
    border-radius:10px; padding:12px; margin-bottom:22px;
  }
  .admin-mini .avatar{
    width:36px; height:36px; border-radius:50%; flex:0 0 auto;
    background:linear-gradient(150deg,var(--navy-500),var(--navy-700));
    color:#fff; display:flex; align-items:center; justify-content:center;
    font-family:'Fraunces',serif; font-size:13px; border:1px solid rgba(255,255,255,0.15);
  }
  .admin-mini .name{ font-size:13px; font-weight:600; color:#fff; }
  .admin-mini .role{ font-family:'IBM Plex Mono',monospace; font-size:10px; color:var(--gold); margin-top:2px; }

  .side-nav{ display:flex; flex-direction:column; gap:3px; flex:1 1 auto; }
  .side-nav .grp-label{
    font-family:'IBM Plex Mono',monospace; font-size:10px; letter-spacing:.14em; text-transform:uppercase;
    color:#5E729B; padding:14px 10px 8px;
  }
  .side-nav button{
    display:flex; align-items:center; gap:12px; width:100%;
    padding:11px 12px; border:0; border-radius:8px; background:transparent;
    color:#AEBBD4; font-size:14px; font-weight:500; text-align:left;
    border-left:2px solid transparent;
    transition:background .15s ease, color .15s ease;
  }
  .side-nav button svg{ flex:0 0 auto; opacity:.85; }
  .side-nav button:hover{ background:rgba(255,255,255,0.06); color:#fff; }
  .side-nav button.active{ background:var(--gold); color:var(--navy-900); border-left-color:var(--gold-dark); }
  .side-nav button.active svg{ opacity:1; }

  .sidebar-bottom{ border-top:1px solid rgba(255,255,255,0.1); padding-top:12px; }
  .logout-btn{
    display:flex; align-items:center; gap:12px; width:100%;
    padding:11px 12px; border:0; border-radius:8px; background:transparent;
    color:#E0A08C; font-size:14px; font-weight:500; text-align:left;
  }
  .logout-btn:hover{ background:rgba(181,83,60,0.18); color:#fff; }

  /* ============ CONTENT ============ */
  .content{ padding:36px 40px 80px; max-width:1240px; }
  .page-head{ display:flex; justify-content:space-between; align-items:flex-end; gap:20px; flex-wrap:wrap; }
  .page-head h2{ font-size:30px; font-weight:500; margin-top:8px; }
  .page-head p{ color:var(--muted); font-size:14px; margin:8px 0 0; max-width:480px; line-height:1.6; }

  .tab-panel{ display:none; }
  .tab-panel.active{ display:block; }

  .btn{
    font-size:13px; font-weight:600; padding:10px 18px; border-radius:8px;
    border:1px solid var(--line); background:var(--paper); color:var(--navy-900);
    display:inline-flex; align-items:center; gap:8px; white-space:nowrap;
    transition:border-color .15s ease, background .15s ease, color .15s ease;
  }
  .btn:hover{ border-color:var(--navy-500); }
  .btn-solid{ background:var(--navy-900); color:var(--cream); border-color:var(--navy-900); }
  .btn-solid:hover{ background:var(--navy-700); }
  .btn-gold{ background:var(--gold); color:var(--navy-900); border-color:var(--gold); }
  .btn-gold:hover{ background:#D8B673; }
  .btn-sm{ padding:7px 12px; font-size:12px; border-radius:6px; }

  /* ============ KPI CARDS ============ */
  .kpi-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin-top:28px; }
  .kpi-card{
    background:var(--paper); border:1px solid var(--line); border-radius:12px;
    padding:22px; display:flex; flex-direction:column; gap:14px;
  }
  .kpi-top{ display:flex; align-items:flex-start; justify-content:space-between; }
  .kpi-icon{
    width:38px; height:38px; border-radius:99px;
    display:flex; align-items:center; justify-content:center; flex:0 0 auto;
  }
  .kpi-icon.i-navy{ background:var(--navy-900); color:var(--gold); }
  .kpi-icon.i-gold{ background:var(--gold-100); color:var(--gold-dark); }
  .kpi-icon.i-danger{ background:var(--danger-100); color:var(--danger); }
  .kpi-icon.i-muted{ background:var(--navy-100); color:var(--navy-700); }
  .kpi-label{ font-family:'IBM Plex Mono',monospace; font-size:10.5px; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
  .kpi-value{ font-family:'Fraunces',serif; font-size:27px; color:var(--navy-900); line-height:1.15; }
  .kpi-sub{ font-size:12px; color:var(--muted); display:flex; align-items:center; gap:6px; }
  .kpi-sub .trend{ font-family:'IBM Plex Mono',monospace; font-weight:600; display:flex; align-items:center; gap:3px; }
  .kpi-sub .trend.up{ color:var(--gold-dark); }
  .kpi-sub .trend.down{ color:var(--danger); }
  .kpi-sub .amount-danger{ font-family:'IBM Plex Mono',monospace; font-weight:600; color:var(--danger); }

  /* ============ SECTION / TABLE ============ */
  .section-card{ background:var(--paper); border:1px solid var(--line); border-radius:12px; overflow:hidden; }
  .section-card-head{
    display:flex; align-items:center; justify-content:space-between; gap:16px;
    padding:20px 22px; border-bottom:1px solid var(--line); flex-wrap:wrap;
  }
  .section-card-head h3{ font-size:17px; font-weight:500; }
  .section-card-head .see-all{
    font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--navy-700);
    border-bottom:1px solid var(--navy-500); padding-bottom:1px;
  }
  .section-card-head .see-all:hover{ color:var(--gold-dark); border-color:var(--gold-dark); }
  .head-tools{ display:flex; gap:10px; align-items:center; }
  .search-mini{
    display:flex; align-items:center; gap:8px;
    border:1px solid var(--line); border-radius:8px; padding:8px 12px;
  }
  .search-mini svg{ opacity:.5; flex:0 0 auto; }
  .search-mini input{ border:0; outline:0; font-size:13px; width:170px; background:transparent; }

  .table-wrap{ overflow-x:auto; }
  table{ width:100%; border-collapse:collapse; min-width:680px; }
  thead th{
    text-align:left; font-family:'IBM Plex Mono',monospace; font-size:10.5px; letter-spacing:.06em;
    text-transform:uppercase; color:var(--muted); font-weight:600;
    background:var(--navy-100); padding:12px 22px; border-bottom:1px solid var(--line);
  }
  tbody td{ padding:14px 22px; font-size:13.5px; border-bottom:1px solid var(--line); color:var(--ink); vertical-align:middle; }
  tbody tr:last-child td{ border-bottom:0; }
  tbody tr:hover{ background:#FCFAF6; }
  td.id-cell{ font-family:'IBM Plex Mono',monospace; font-size:12.5px; color:var(--navy-700); font-weight:600; }
  td.amount{ font-family:'IBM Plex Mono',monospace; font-weight:600; }
  .person-cell{ display:flex; align-items:center; gap:10px; }
  .person-cell .av{
    width:32px; height:32px; border-radius:50%; flex:0 0 auto;
    background:linear-gradient(150deg,var(--navy-500),var(--navy-800));
    color:#fff; display:flex; align-items:center; justify-content:center;
    font-family:'Fraunces',serif; font-size:12px;
  }
  .person-cell .nm{ font-weight:600; color:var(--navy-900); }

  .badge{
    display:inline-flex; align-items:center; gap:6px;
    font-family:'IBM Plex Mono',monospace; font-size:11px; font-weight:600;
    padding:5px 10px; border-radius:999px; white-space:nowrap;
  }
  .badge::before{ content:""; width:6px; height:6px; border-radius:50%; }
  .badge.active-s{ background:var(--gold-100); color:var(--gold-dark); }
  .badge.active-s::before{ background:var(--gold-dark); }
  .badge.locked-s{ background:var(--danger-100); color:var(--danger); }
  .badge.locked-s::before{ background:var(--danger); }
  .badge.role-manager{ background:var(--navy-900); color:#fff; }
  .badge.role-manager::before{ background:var(--gold); }
  .badge.role-cashier{ background:var(--navy-100); color:var(--navy-700); }
  .badge.role-cashier::before{ background:var(--navy-700); }
  .badge.role-stock{ background:#F1EEE6; color:#8A6B32; }
  .badge.role-stock::before{ background:#8A6B32; }
  .badge.stock-ok{ background:var(--navy-100); color:var(--navy-700); }
  .badge.stock-ok::before{ background:var(--navy-700); }
  .badge.stock-low{ background:var(--gold-100); color:var(--gold-dark); }
  .badge.stock-low::before{ background:var(--gold-dark); }
  .badge.stock-out{ background:var(--danger-100); color:var(--danger); }
  .badge.stock-out::before{ background:var(--danger); }

  .row-actions{ display:flex; gap:8px; flex-wrap:wrap; }
  .row-actions button{
    font-family:'IBM Plex Mono',monospace; font-size:11px; font-weight:600;
    padding:6px 11px; border-radius:6px; border:1px solid var(--line); background:transparent; color:var(--navy-700);
    cursor:pointer;
  }
  .row-actions button:hover{ border-color:var(--navy-500); }
  .row-actions button.danger{ color:var(--danger); }
  .row-actions button.danger:hover{ border-color:var(--danger); background:var(--danger-100); }
  .row-actions button.unlock{ color:var(--gold-dark); }
  .row-actions button.unlock:hover{ border-color:var(--gold-dark); background:var(--gold-100); }

  /* ============ CHART & REVENUE ANALYTICS (Thống kê doanh thu) ============ */
  .stat-row{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:28px; margin-bottom:24px; }
  .stat-mini{ background:var(--paper); border:1px solid var(--line); border-radius:12px; padding:20px 22px; }
  .stat-mini .lbl{ font-family:'IBM Plex Mono',monospace; font-size:10.5px; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
  .stat-mini .val{ font-family:'Fraunces',serif; font-size:24px; margin-top:8px; color:var(--navy-900); }

  .rev-filter-card {
    background: var(--paper); border: 1px solid var(--line); border-radius: 12px;
    padding: 22px 24px; margin-top: 20px; margin-bottom: 24px;
    box-shadow: 0 2px 10px rgba(10,25,48,0.04);
  }
  .rev-filter-row {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 16px; margin-bottom: 18px;
  }
  @media (max-width: 1200px) {
    .rev-filter-row { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .rev-filter-row { grid-template-columns: 1fr; }
  }
  .rev-filter-group { display: flex; flex-direction: column; gap: 6px; }
  .rev-filter-group label {
    font-size: 11px; font-weight: 600; text-transform: uppercase;
    letter-spacing: .05em; color: var(--navy-700); font-family: 'IBM Plex Mono', monospace;
  }
  .rev-filter-group input[type="date"], .rev-filter-group select {
    width: 100%; height: 38px; border: 1px solid var(--line); border-radius: 8px; padding: 0 12px;
    font-size: 13px; outline: 0; background: var(--paper); color: var(--ink);
    font-family: inherit; font-weight: 500; transition: border-color .15s ease;
    box-sizing: border-box;
  }
  .rev-filter-group input[type="date"]:focus, .rev-filter-group select:focus {
    border-color: var(--navy-500); box-shadow: 0 0 0 3px rgba(46,85,144,0.1);
  }
  .quick-dates-bar {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 14px; padding-top: 16px; border-top: 1px solid var(--line);
  }
  .quick-pills { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .quick-pills-label { font-size: 11px; font-family: 'IBM Plex Mono', monospace; color: var(--muted); text-transform: uppercase; margin-right: 4px; font-weight: 600; }
  .quick-pill {
    border: 1px solid var(--line); background: var(--paper); color: var(--navy-700);
    font-size: 12px; font-weight: 500; padding: 6px 13px; border-radius: 999px;
    cursor: pointer; transition: all .15s ease; font-family: 'IBM Plex Mono', monospace;
  }
  .quick-pill:hover { border-color: var(--navy-500); color: var(--navy-900); background: var(--navy-100); }
  .quick-pill.active {
    background: var(--navy-900); border-color: var(--navy-900); color: #fff;
  }
  .rev-export-btns { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }

  .stat-row-5 {
    display: grid; grid-template-columns: repeat(5, 1fr);
    gap: 16px; margin-bottom: 24px;
  }
  @media (max-width: 1200px) {
    .stat-row-5 { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  }
  .stat-card-rev {
    background: var(--paper); border: 1px solid var(--line); border-radius: 12px;
    padding: 18px 20px; display: flex; flex-direction: column; justify-content: space-between;
    position: relative; overflow: hidden;
  }
  .stat-card-rev::after {
    content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%;
    background: var(--navy-300);
  }
  .stat-card-rev.highlight::after { background: var(--gold); }
  .stat-card-rev .lbl {
    font-family: 'IBM Plex Mono', monospace; font-size: 10.5px;
    letter-spacing: .08em; text-transform: uppercase; color: var(--muted);
  }
  .stat-card-rev .val {
    font-family: 'Fraunces', serif; font-size: 22px; margin-top: 6px; color: var(--navy-900);
  }
  .stat-card-rev .sub {
    font-size: 11.5px; color: var(--muted); margin-top: 4px; display: flex; align-items: center; gap: 4px;
  }

  .rev-grid-2 {
    display: grid; grid-template-columns: 1.6fr 1fr; gap: 20px; margin-bottom: 24px;
  }
  @media (max-width: 1024px) {
    .rev-grid-2 { grid-template-columns: 1fr; }
  }

  .rank-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px; border-bottom: 1px solid var(--line); gap: 12px;
  }
  .rank-item:last-child { border-bottom: 0; }
  .rank-badge {
    width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center;
    justify-content: center; font-size: 11px; font-weight: 700; font-family: 'IBM Plex Mono', monospace;
    flex-shrink: 0; background: var(--navy-100); color: var(--navy-700);
  }
  .rank-badge.rank-1 { background: #FEF3C7; color: #B45309; border: 1px solid #FCD34D; }
  .rank-badge.rank-2 { background: #E2E8F0; color: #475569; border: 1px solid #CBD5E1; }
  .rank-badge.rank-3 { background: #FFEDD5; color: #C2410C; border: 1px solid #FDBA74; }
  .rank-info { flex: 1; min-width: 0; }
  .rank-title { font-weight: 600; font-size: 13px; color: var(--navy-900); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rank-sub { font-size: 11.5px; color: var(--muted); display: flex; gap: 8px; margin-top: 2px; }
  .rank-val { text-align: right; font-family: 'IBM Plex Mono', monospace; font-size: 13px; font-weight: 600; color: var(--gold-dark); white-space: nowrap; }
  .rank-progress { width: 100%; height: 4px; background: var(--navy-100); border-radius: 2px; margin-top: 6px; overflow: hidden; }
  .rank-bar { height: 100%; background: linear-gradient(90deg, var(--navy-500), var(--gold)); border-radius: 2px; }

  .ratio-bar-wrap { margin-bottom: 14px; }
  .ratio-bar-wrap:last-child { margin-bottom: 0; }
  .ratio-head { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px; }
  .ratio-head .name { font-weight: 500; color: var(--navy-900); }
  .ratio-head .amount { font-family: 'IBM Plex Mono', monospace; font-weight: 600; color: var(--navy-700); }
  .ratio-progress { height: 7px; background: var(--navy-100); border-radius: 4px; overflow: hidden; display: flex; }
  .ratio-fill { height: 100%; border-radius: 4px; transition: width .3s ease; }

  .chart-card{ background:var(--paper); border:1px solid var(--line); border-radius:12px; padding:24px 24px 18px; }
  .chart-card h3{ font-size:16px; font-weight:500; margin-bottom:4px; }
  .chart-card .chart-sub{ font-size:12.5px; color:var(--muted); margin-bottom:20px; }
  .bar-chart{ display:flex; align-items:flex-end; gap:8px; height:220px; overflow-x:auto; padding-bottom:4px; }
  .bar-col{ flex:1; min-width:24px; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%; gap:8px; }
  .bar{
    width:100%; max-width:38px; border-radius:5px 5px 2px 2px;
    background:linear-gradient(180deg,var(--navy-500),var(--navy-800));
    position:relative; transition:background .15s ease;
  }
  .bar.peak{ background:linear-gradient(180deg,var(--gold),var(--gold-dark)); }
  .bar:hover{ filter:brightness(1.1); }
  .bar-col .m-label{ font-family:'IBM Plex Mono',monospace; font-size:10.5px; color:var(--muted); white-space:nowrap; }
  .bar-tooltip{
    position:absolute; top:-32px; left:50%; transform:translateX(-50%);
    background:var(--navy-900); color:#fff; font-family:'IBM Plex Mono',monospace; font-size:10px;
    padding:4px 8px; border-radius:5px; white-space:nowrap; opacity:0; pointer-events:none;
    transition:opacity .12s ease; z-index: 10;
  }
  .bar:hover .bar-tooltip{ opacity:1; }

  /* ============ MODAL POPUP (Thêm / Sửa Sách & Multer Upload) ============ */
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(10, 25, 48, 0.6);
    backdrop-filter: blur(4px);
    display: none; align-items: center; justify-content: center;
    z-index: 100; padding: 20px;
  }
  .modal-overlay.active { display: flex; }
  
  .modal-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    width: 100%; max-width: 580px;
    max-height: 90vh; overflow-y: auto;
    padding: 28px 30px;
    box-shadow: var(--shadow-soft);
    position: relative;
  }
  .modal-card h3 { font-size: 22px; font-weight: 500; margin-bottom: 6px; }
  .modal-card p.sub { font-size: 13px; color: var(--muted); margin-bottom: 20px; }

  .modal-form { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
  .modal-form .full { grid-column: 1 / -1; }
  .modal-form label { font-size: 12px; font-weight: 600; color: var(--navy-900); display: block; margin-bottom: 4px; }
  .modal-form input[type="text"], .modal-form input[type="number"], .modal-form input[type="file"],
  .modal-form input[type="email"], .modal-form input[type="password"], .modal-form input[type="tel"],
  .modal-form select {
    width: 100%; border: 1px solid var(--line); border-radius: 6px; padding: 9px 12px;
    font-family: 'Inter', sans-serif; font-size: 13.5px; color: var(--ink); outline: 0;
    background: var(--paper);
  }
  .modal-form select { cursor: pointer; }
  .modal-form input:focus, .modal-form select:focus { border-color: var(--navy-500); box-shadow: 0 0 0 3px rgba(46,85,144,0.12); }
  
  .preview-container { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px; }
  .preview-thumb {
    position: relative; width: 80px; height: 100px; border-radius: 6px; overflow: hidden;
    border: 2px solid var(--line); cursor: pointer; background: var(--navy-100);
    transition: all .15s ease;
  }
  .preview-thumb.is-cover { border-color: var(--gold); box-shadow: 0 0 0 2px rgba(199,161,90,0.3); }
  .preview-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .preview-thumb .badge-cover {
    position: absolute; bottom: 0; left: 0; right: 0;
    background: rgba(10,25,48,0.85); color: #fff; font-size: 9px; font-family: 'IBM Plex Mono', monospace;
    text-align: center; padding: 3px 0; font-weight: 600;
  }
  .preview-thumb.is-cover .badge-cover { background: var(--gold-dark); }

  .book-thumb-small {
    width: 32px; height: 44px; border-radius: 3px; object-fit: cover;
    border: 1px solid var(--line); background: var(--navy-100); flex-shrink: 0;
  }

  .modal-actions {
    grid-column: 1 / -1;
    display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px;
  }

  /* ============ MODERN TOAST & CUSTOM CONFIRM SYSTEM ============ */
  #toast-container {
    position: fixed; top: 20px; right: 20px; z-index: 99999;
    display: flex; flex-direction: column; gap: 10px; max-width: 380px; width: calc(100% - 40px);
    pointer-events: none;
  }
  .custom-toast {
    pointer-events: auto; background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-radius: 12px; padding: 14px 16px; position: relative; overflow: hidden;
    box-shadow: 0 12px 32px -8px rgba(10, 25, 48, 0.18), 0 0 0 1px rgba(255,255,255,0.6);
    display: flex; align-items: flex-start; gap: 12px;
    animation: toastIn 0.35s cubic-bezier(0.21, 1.02, 0.73, 1) forwards;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .custom-toast.hide { animation: toastOut 0.3s ease forwards; }
  @keyframes toastIn { from { opacity: 0; transform: translateX(50px) scale(0.95); } to { opacity: 1; transform: translateX(0) scale(1); } }
  @keyframes toastOut { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(60px); } }
  .toast-icon { width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 13px; font-weight: 700; color: #fff; }
  .toast-success .toast-icon { background: #10B981; }
  .toast-error .toast-icon { background: #EF4444; }
  .toast-warning .toast-icon { background: #F59E0B; }
  .toast-info .toast-icon { background: #3B82F6; }
  .toast-content { flex: 1; }
  .toast-title { font-weight: 600; font-size: 13.5px; margin-bottom: 2px; color: #0F172A; }
  .toast-msg { font-size: 12.5px; color: #475569; line-height: 1.4; }
  .toast-close { border: 0; background: transparent; color: #94A3B8; font-size: 16px; cursor: pointer; padding: 0 4px; line-height: 1; }
  .toast-close:hover { color: #0F172A; }
  .toast-progress { position: absolute; bottom: 0; left: 0; height: 3px; width: 100%; animation: toastProgress 3s linear forwards; }
  .toast-success .toast-progress { background: #10B981; }
  .toast-error .toast-progress { background: #EF4444; }
  .toast-warning .toast-progress { background: #F59E0B; }
  .toast-info .toast-progress { background: #3B82F6; }
  @keyframes toastProgress { from { width: 100%; } to { width: 0%; } }

  .confirm-overlay {
    position: fixed; inset: 0; z-index: 100000;
    background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center; padding: 20px;
    opacity: 0; pointer-events: none; transition: opacity 0.2s ease;
  }
  .confirm-overlay.active { opacity: 1; pointer-events: auto; }
  .confirm-modal {
    background: #FFFFFF; border-radius: 16px; max-width: 400px; width: 100%;
    padding: 24px 26px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
    transform: scale(0.9); transition: transform 0.2s ease; text-align: center;
  }
  .confirm-overlay.active .confirm-modal { transform: scale(1); }
  .confirm-icon {
    width: 48px; height: 48px; border-radius: 50%; background: #FEF3C7; color: #D97706;
    display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-size: 22px; font-weight: 700;
  }
  .confirm-title { font-size: 18px; font-weight: 600; color: #0F172A; margin-bottom: 8px; font-family: 'Fraunces', serif; }
  .confirm-msg { font-size: 13.5px; color: #475569; margin-bottom: 22px; line-height: 1.5; }
  .confirm-actions { display: flex; gap: 10px; justify-content: center; }
  .confirm-btn { flex: 1; padding: 10px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 600; border: 1px solid #CBD5E1; background: #FFF; color: #334155; cursor: pointer; transition: all 0.15s ease; }
  .confirm-btn:hover { background: #F8FAFC; }
  .confirm-btn-primary { background: #0F172A; color: #FFF; border-color: #0F172A; }
  .confirm-btn-primary:hover { background: #1E293B; }

  /* ============ RESPONSIVE ============ */
  @media (max-width:1100px){
    .kpi-grid{ grid-template-columns:repeat(2,1fr); }
    .stat-row{ grid-template-columns:1fr; }
  }
  @media (max-width:860px){
    .app{ grid-template-columns:1fr; }
    .sidebar{ position:static; height:auto; flex-direction:row; flex-wrap:wrap; align-items:center; padding:16px; }
    .brand{ padding:0; margin-right:auto; }
    .admin-mini{ display:none; }
    .side-nav{ flex-direction:row; flex-wrap:wrap; flex:0 0 auto; width:100%; margin-top:14px; }
    .side-nav .grp-label{ display:none; }
    .side-nav button{ width:auto; border-left:0; border-radius:999px; padding:8px 14px; }
    .side-nav button.active{ border-left:0; }
    .sidebar-bottom{ border-top:0; padding-top:0; margin-left:auto; }
    .content{ padding:26px 20px 60px; }
  }
  @media (max-width:560px){
    .kpi-grid{ grid-template-columns:1fr; }
    .page-head h2{ font-size:24px; }
    .modal-form{ grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<div class="app">

  <!-- ============ SIDEBAR ============ -->
  <aside class="sidebar">
    <div class="brand">
      <div class="mark">L</div>
      <div class="txt">
        <div class="name">L'Amour</div>
        <div class="tag">Admin Panel</div>
      </div>
    </div>

    <div class="admin-mini">
      <div class="avatar">QT</div>
      <div>
        <div class="name">Lê Thị Quỳnh</div>
        <div class="role">Quản trị viên</div>
      </div>
    </div>

    <nav class="side-nav" id="sideNav">
      <span class="grp-label">Điều hành</span>
      <button data-tab="overview" class="active">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
        Tổng quan
      </button>
      <button data-tab="books">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        Quản lý sách
      </button>
      <button data-tab="staff">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Quản lý nhân viên
      </button>
      <button data-tab="settings">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Quản lý Trang Chủ
      </button>
      <button data-tab="revenue">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3v18h18"/><path d="M7 15l4-6 3 4 5-8"/></svg>
        Thống kê doanh thu
      </button>
      <button data-tab="invoices">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Lịch sử mua hàng
      </button>
    </nav>

    <div class="sidebar-bottom">
      <button class="logout-btn" id="logoutBtn">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Đăng xuất
      </button>
    </div>
  </aside>

  <!-- ============ CONTENT ============ -->
  <div class="content">

    <!-- ===================== TAB: TỔNG QUAN ===================== -->
    <section class="tab-panel active" id="tab-overview">
      <div class="page-head">
        <div>
          <p class="eyebrow">Bảng điều khiển</p>
          <h2>Tổng quan</h2>
          <p>Số liệu vận hành cửa hàng tính đến hôm nay, 13/08/2026.</p>
        </div>
      </div>

      <!-- 4 KPI cards -->
      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-top">
            <span class="kpi-icon i-navy">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </span>
          </div>
          <div>
            <div class="kpi-label">Tổng doanh thu tháng</div>
            <div class="kpi-value" id="kpiTotalRevenue">0₫</div>
          </div>
          <div class="kpi-sub"><span class="trend up">▲ Tính từ DB</span></div>
        </div>

        <div class="kpi-card">
          <div class="kpi-top">
            <span class="kpi-icon i-gold">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.6L22 7H6"/><circle cx="9" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg>
            </span>
          </div>
          <div>
            <div class="kpi-label">Tổng số đơn hàng</div>
            <div class="kpi-value" id="kpiTotalOrders">0 đơn</div>
          </div>
          <div class="kpi-sub"><span class="trend up">▲ Cập nhật liên tục</span></div>
        </div>

        <div class="kpi-card">
          <div class="kpi-top">
            <span class="kpi-icon i-navy">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </span>
          </div>
          <div>
            <div class="kpi-label">Đơn chờ xử lý & giao</div>
            <div class="kpi-value" id="kpiPendingDeliveryOrders">0 đơn</div>
          </div>
          <div class="kpi-sub">Đang thực hiện <span class="amount-accent" id="kpiPendingDeliveryAmount" style="color:var(--navy-700); font-weight:700;">0₫</span></div>
        </div>

        <div class="kpi-card">
          <div class="kpi-top">
            <span class="kpi-icon i-muted">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 8 12 3 3 8l9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg>
            </span>
          </div>
          <div>
            <div class="kpi-label">Tổng sách tồn kho</div>
            <div class="kpi-value" id="kpiTotalBooks">0 cuốn</div>
          </div>
          <div class="kpi-sub"><span class="trend up">Cập nhật trực tiếp</span></div>
        </div>
      </div>

      <div class="perforation"><span></span><span></span><span></span><div class="rule"></div></div>

      <!-- Staff table -->
      <div class="section-card">
        <div class="section-card-head">
          <h3>Nhân viên đang làm việc</h3>
          <a href="#" class="see-all" data-goto="staff">Xem tất cả →</a>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Mã NV</th>
                <th>Họ tên</th>
                <th>Role</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
              </tr>
            </thead>
            <tbody id="staffTableBodyOverview"><!-- injected by fetchStaff() --></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===================== TAB: QUẢN LÝ SÁCH ===================== -->
    <section class="tab-panel" id="tab-books">
      <div class="page-head">
        <div>
          <p class="eyebrow">Kho hàng</p>
          <h2>Quản lý sách</h2>
          <p>Danh sách toàn bộ đầu sách đang kinh doanh tại cửa hàng.</p>
        </div>
        <button class="btn btn-solid" onclick="openBookModal()">+ Thêm sách mới</button>
      </div>

      <div class="perforation"><span></span><span></span><span></span><div class="rule"></div></div>

      <div class="section-card">
        <div class="section-card-head">
          <h3>Danh sách sách (<span id="bookHeaderCount">0 đầu sách</span>)</h3>
          <div class="head-tools">
            <div class="search-mini">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input id="bookSearch" type="text" placeholder="Tìm tên sách, tác giả...">
            </div>
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Ảnh bìa</th>
                <th>Mã sách</th>
                <th>Tên sách</th>
                <th>Tác giả</th>
                <th>Thể loại</th>
                <th>Tồn kho</th>
                <th>Giá bán</th>
                <th>Vị trí kệ</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
              </tr>
            </thead>
            <tbody id="bookTableBody"><!-- injected by fetchBooks() --></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===================== TAB: QUẢN LÝ NHÂN VIÊN ===================== -->
    <section class="tab-panel" id="tab-staff">
      <div class="page-head">
        <div>
          <p class="eyebrow">Nhân sự</p>
          <h2>Quản lý nhân viên</h2>
          <p>Phân quyền và theo dõi trạng thái hoạt động của toàn bộ nhân viên.</p>
        </div>
        <button class="btn btn-solid" onclick="openStaffModal()">+ Thêm nhân viên</button>
      </div>

      <div class="perforation"><span></span><span></span><span></span><div class="rule"></div></div>

      <div class="section-card">
        <div class="section-card-head">
          <h3>Toàn bộ nhân viên (<span id="staffCount">0</span>)</h3>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Mã NV</th>
                <th>Họ tên</th>
                <th>Role</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
              </tr>
            </thead>
            <tbody id="staffTableBodyFull"><!-- injected by fetchStaff() --></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===================== TAB: QUẢN LÝ TRANG CHỦ (CMS) ===================== -->
    <section class="tab-panel" id="tab-settings">
      <div class="page-head">
        <div>
          <p class="eyebrow">Hệ thống Quản trị Nội dung (CMS)</p>
          <h2>Quản lý Trang Chủ & Cấu hình Website</h2>
          <p>Tùy chỉnh Slider nghệ thuật, thông tin liên hệ, mạng xã hội và chân trang trực tiếp ra ngoài website.</p>
        </div>
        <button class="btn btn-gold" onclick="document.getElementById('settingsForm').requestSubmit()">💾 Lưu Cấu Hình Trang Chủ</button>
      </div>

      <div class="perforation"><span></span><span></span><span></span><div class="rule"></div></div>

      <form id="settingsForm" onsubmit="saveSettings(event)" style="display:flex; flex-direction:column; gap:24px;">
        
        <!-- CARD 1: CẤU HÌNH HERO BANNERS -->
        <div class="section-card">
          <div class="section-card-head" style="background:#FAF8F5;">
            <div style="display:flex; align-items:center; gap:8px;">
              <span style="font-size:18px;">🎬</span>
              <h3 style="font-size:16.5px; color:var(--navy-900);">Card 1: Cấu hình Hero Slider Banners</h3>
            </div>
            <span style="font-size:12px; color:var(--muted);">Banner tràn viền Cinematic trên đầu trang chủ</span>
          </div>
          <div style="padding:22px; display:flex; flex-direction:column; gap:20px;">
            <div id="bannersContainer" style="max-width:620px; width:100%; margin:0 auto;">
              <!-- Rendered via renderSingleBannerForm(index) -->
            </div>
          </div>
        </div>

        <!-- CARD 2: THÔNG TIN LIÊN HỆ -->
        <div class="section-card">
          <div class="section-card-head" style="background:#FAF8F5;">
            <div style="display:flex; align-items:center; gap:8px;">
              <span style="font-size:18px;">📞</span>
              <h3 style="font-size:16.5px; color:var(--navy-900);">Card 2: Thông tin liên hệ hiệu sách</h3>
            </div>
          </div>
          <div style="padding:22px; display:grid; grid-template-columns:repeat(3, 1fr); gap:16px;">
            <div class="form-group">
              <label style="font-size:12px; font-weight:600; color:var(--navy-900);">Hotline / Số điện thoại (*)</label>
              <input type="text" id="cfgContactPhone" required placeholder="1900 8888" style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13.5px;">
            </div>
            <div class="form-group">
              <label style="font-size:12px; font-weight:600; color:var(--navy-900);">Email hỗ trợ (*)</label>
              <input type="email" id="cfgContactEmail" required placeholder="contact@lamour.vn" style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13.5px;">
            </div>
            <div class="form-group">
              <label style="font-size:12px; font-weight:600; color:var(--navy-900);">Giờ mở cửa / Làm việc</label>
              <input type="text" id="cfgContactTime" placeholder="08:00 - 22:00 (Hàng ngày)" style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13.5px;">
            </div>
            <div class="form-group" style="grid-column: span 1.5;">
              <label style="font-size:12px; font-weight:600; color:var(--navy-900);">Địa chỉ Chi nhánh 1</label>
              <input type="text" id="cfgContactAddress1" placeholder="128 Nguyễn Trãi, P. Bến Thành, Quận 1, TP. HCM" style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13.5px;">
            </div>
            <div class="form-group" style="grid-column: span 1.5;">
              <label style="font-size:12px; font-weight:600; color:var(--navy-900);">Địa chỉ Chi nhánh 2</label>
              <input type="text" id="cfgContactAddress2" placeholder="45 Đinh Tiên Hoàng, P. Đa Kao, Quận 1, TP. HCM" style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13.5px;">
            </div>
          </div>
        </div>

        <!-- CARD 3: MẠNG XÃ HỘI -->
        <div class="section-card">
          <div class="section-card-head" style="background:#FAF8F5;">
            <div style="display:flex; align-items:center; gap:8px;">
              <span style="font-size:18px;">🌐</span>
              <h3 style="font-size:16.5px; color:var(--navy-900);">Card 3: Liên kết Mạng Xã Hội (Floating & Footer)</h3>
            </div>
          </div>
          <div style="padding:22px; display:grid; grid-template-columns:repeat(3, 1fr); gap:16px;">
            <div class="form-group">
              <label style="font-size:12px; font-weight:600; color:var(--navy-900);">Link Zalo Chat</label>
              <input type="text" id="cfgSocialZalo" placeholder="https://zalo.me/..." style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13.5px;">
            </div>
            <div class="form-group">
              <label style="font-size:12px; font-weight:600; color:var(--navy-900);">Link Messenger</label>
              <input type="text" id="cfgSocialMessenger" placeholder="https://m.me/..." style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13.5px;">
            </div>
            <div class="form-group">
              <label style="font-size:12px; font-weight:600; color:var(--navy-900);">Link Facebook Fanpage</label>
              <input type="text" id="cfgSocialFacebook" placeholder="https://facebook.com/..." style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13.5px;">
            </div>
            <div class="form-group">
              <label style="font-size:12px; font-weight:600; color:var(--navy-900);">Link Instagram</label>
              <input type="text" id="cfgSocialInstagram" placeholder="https://instagram.com/..." style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13.5px;">
            </div>
            <div class="form-group">
              <label style="font-size:12px; font-weight:600; color:var(--navy-900);">Link TikTok</label>
              <input type="text" id="cfgSocialTiktok" placeholder="https://tiktok.com/@..." style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13.5px;">
            </div>
          </div>
        </div>

        <!-- CARD 4: FOOTER -->
        <div class="section-card">
          <div class="section-card-head" style="background:#FAF8F5;">
            <div style="display:flex; align-items:center; gap:8px;">
              <span style="font-size:18px;">📄</span>
              <h3 style="font-size:16.5px; color:var(--navy-900);">Card 4: Thông tin Chân trang (Footer)</h3>
            </div>
          </div>
          <div style="padding:22px; display:flex; flex-direction:column; gap:16px;">
            <div class="form-group">
              <label style="font-size:12px; font-weight:600; color:var(--navy-900);">Đoạn văn giới thiệu ngắn (Footer About)</label>
              <textarea id="cfgFooterAbout" rows="3" placeholder="Không gian lưu giữ và lan tỏa những giá trị tri thức nghệ thuật..." style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13.5px; font-family:inherit;"></textarea>
            </div>
            <div class="form-group">
              <label style="font-size:12px; font-weight:600; color:var(--navy-900);">Dòng chữ Bản quyền (Copyright)</label>
              <input type="text" id="cfgFooterCopyright" placeholder="© 2026 L'Amour Bookstore. Bản quyền thuộc về L'Amour." style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13.5px;">
            </div>
          </div>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:12px; margin-top:10px;">
          <button type="submit" class="btn btn-gold" style="padding:12px 28px; font-size:15px; font-weight:700;">💾 Lưu Cấu Hình Trang Chủ</button>
        </div>

      </form>
    </section>

    <!-- ===================== TAB: THỐNG KÊ DOANH THU ===================== -->
    <section class="tab-panel" id="tab-revenue">
      <div class="page-head">
        <div>
          <p class="eyebrow">Báo cáo & Phân tích chuyên sâu</p>
          <h2>Thống kê doanh thu & Phân tích bán hàng</h2>
          <p>Bộ lọc đa chiều theo khoảng thời gian, tác giả, cuốn sách, thể loại sách và phương thức thanh toán.</p>
        </div>
      </div>

      <!-- KHUNG BỘ LỌC ĐA CHIỀU (CÂN ĐỐI 4 CỘT X 2 HÀNG) -->
      <div class="rev-filter-card">
        <div class="rev-filter-row">
          <div class="rev-filter-group">
            <label for="revStartDate">Từ ngày (Bắt đầu)</label>
            <input type="date" id="revStartDate">
          </div>
          <div class="rev-filter-group">
            <label for="revEndDate">Đến ngày (Kết thúc)</label>
            <input type="date" id="revEndDate">
          </div>
          <div class="rev-filter-group">
            <label for="revAuthorFilter">Tác giả</label>
            <select id="revAuthorFilter">
              <option value="all">-- Tất cả tác giả --</option>
            </select>
          </div>
          <div class="rev-filter-group">
            <label for="revBookFilter">Cuốn sách</label>
            <select id="revBookFilter">
              <option value="all">-- Tất cả cuốn sách --</option>
            </select>
          </div>

          <div class="rev-filter-group">
            <label for="revCategoryFilter">Thể loại</label>
            <select id="revCategoryFilter">
              <option value="all">-- Tất cả thể loại --</option>
            </select>
          </div>
          <div class="rev-filter-group">
            <label for="revPaymentFilter">Phương thức thanh toán</label>
            <select id="revPaymentFilter">
              <option value="all">-- Tất cả phương thức --</option>
              <option value="cash">Tiền mặt (quầy)</option>
              <option value="transfer">Chuyển khoản (banking)</option>
              <option value="card">Thẻ POS</option>
            </select>
          </div>
          <div class="rev-filter-group">
            <label for="revStatusFilter">Trạng thái đơn hàng</label>
            <select id="revStatusFilter">
              <option value="paid_completed" selected>Đã TT & Hoàn thành</option>
              <option value="all">Tất cả trạng thái</option>
              <option value="paid">Đã thanh toán (paid)</option>
              <option value="completed">Đã hoàn thành (completed)</option>
              <option value="unpaid">Chưa thanh toán (unpaid)</option>
              <option value="processing">Đang xử lý (processing)</option>
              <option value="shipping">Đang giao hàng (shipping)</option>
              <option value="overdue">Quá hạn (overdue)</option>
              <option value="cancelled">Đã hủy (cancelled)</option>
            </select>
          </div>
          <div class="rev-filter-group">
            <label>Thao tác lọc</label>
            <div style="display:flex; gap:8px; height:38px;">
              <button type="button" class="btn btn-primary" style="flex:1; justify-content:center; padding:0 12px; height:38px; font-weight:600;" onclick="applyRevenueFilter()">Áp dụng lọc</button>
              <button type="button" class="btn" style="padding:0 14px; height:38px; justify-content:center;" onclick="resetRevenueFilter()">Đặt lại</button>
            </div>
          </div>
        </div>

        <div class="quick-dates-bar">
          <div class="quick-pills">
            <span class="quick-pills-label">Chọn nhanh:</span>
            <button type="button" class="quick-pill" onclick="setRevenueQuickRange('today')">Hôm nay</button>
            <button type="button" class="quick-pill" onclick="setRevenueQuickRange('7days')">7 ngày qua</button>
            <button type="button" class="quick-pill" onclick="setRevenueQuickRange('30days')">30 ngày qua</button>
            <button type="button" class="quick-pill" onclick="setRevenueQuickRange('thisMonth')">Tháng này</button>
            <button type="button" class="quick-pill" onclick="setRevenueQuickRange('thisYear')">Năm 2026</button>
            <button type="button" class="quick-pill active" onclick="setRevenueQuickRange('all')">Toàn thời gian</button>
          </div>
          <div class="rev-export-btns">
            <button type="button" class="btn" style="height:36px; padding:0 14px; font-weight:600;" onclick="exportRevenueCSV()">📥 Xuất Excel (CSV)</button>
            <button type="button" class="btn" style="height:36px; padding:0 14px;" onclick="window.print()">🖨 In báo cáo</button>
          </div>
        </div>
      </div>

      <!-- THẺ KPI TỔNG QUAN NÂNG CAO -->
      <div class="stat-row-5">
        <div class="stat-card-rev highlight">
          <div class="lbl">Tổng doanh thu</div>
          <div class="val" id="statRevTotal">0₫</div>
          <div class="sub" id="statRevPercentOfAll">Đã lọc theo tiêu chí</div>
        </div>
        <div class="stat-card-rev">
          <div class="lbl">Số đơn hàng</div>
          <div class="val" id="statRevOrders">0 đơn</div>
          <div class="sub" id="statRevCompletedRate">Tỷ lệ hoàn thành: 100%</div>
        </div>
        <div class="stat-card-rev">
          <div class="lbl">Sách đã bán</div>
          <div class="val" id="statRevBooksSold">0 cuốn</div>
          <div class="sub" id="statRevUniqueBooks">0 đầu sách khác nhau</div>
        </div>
        <div class="stat-card-rev">
          <div class="lbl">Giá trị TB / đơn (AOV)</div>
          <div class="val" id="statRevAOV">0₫</div>
          <div class="sub">Doanh thu / số đơn</div>
        </div>
        <div class="stat-card-rev">
          <div class="lbl">Doanh thu đỉnh</div>
          <div class="val" id="statRevPeak">0₫</div>
          <div class="sub" id="statRevPeakLabel">Mốc thời gian cao nhất</div>
        </div>
      </div>

      <!-- HÀNG BIỂU ĐỒ & CƠ CẤU DOANH THU -->
      <div class="rev-grid-2">
        <div class="chart-card">
          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:4px;">
            <h3 id="chartMainTitle">Biến động doanh thu theo thời gian</h3>
            <span class="badge stock-ok" id="chartPeriodBadge">MongoDB Live</span>
          </div>
          <p class="chart-sub" id="chartSubLabel">Đơn vị: VNĐ — Biểu đồ động hiển thị theo bộ lọc đang chọn</p>
          <div class="bar-chart" id="barChart"><!-- injected by renderRevenueAnalytics() --></div>
        </div>

        <div class="chart-card">
          <h3>Cơ cấu Doanh thu & Tỷ trọng</h3>
          <p class="chart-sub">Phân bổ theo Thể loại & Phương thức thanh toán</p>
          <div style="font-weight:600; font-size:12.5px; margin-bottom:10px; color:var(--navy-900);">Theo thể loại sách:</div>
          <div id="revCategoryBreakdown">
            <!-- Injected by renderRevenueAnalytics() -->
          </div>
          <div style="font-weight:600; font-size:12.5px; margin-top:16px; margin-bottom:10px; color:var(--navy-900); padding-top:14px; border-top:1px solid var(--line);">Theo phương thức thanh toán:</div>
          <div id="revPaymentBreakdown">
            <!-- Injected by renderRevenueAnalytics() -->
          </div>
        </div>
      </div>

      <!-- HÀNG TOP TÁC GIẢ & TOP SÁCH BÁN CHẠY -->
      <div class="rev-grid-2">
        <div class="section-card">
          <div class="section-card-head">
            <h3>Top 5 Tác giả doanh thu cao nhất</h3>
            <span class="mono" style="font-size:11.5px; color:var(--muted);">Doanh thu / Số cuốn</span>
          </div>
          <div id="topAuthorsList">
            <!-- Injected by renderRevenueAnalytics() -->
          </div>
        </div>

        <div class="section-card">
          <div class="section-card-head">
            <h3>Top 5 Cuốn sách bán chạy nhất</h3>
            <span class="mono" style="font-size:11.5px; color:var(--muted);">Doanh thu / Số cuốn</span>
          </div>
          <div id="topBooksList">
            <!-- Injected by renderRevenueAnalytics() -->
          </div>
        </div>
      </div>

      <!-- BẢNG CHI TIẾT BÁN HÀNG THEO BỘ LỌC -->
      <div class="section-card" style="margin-top:24px;">
        <div class="section-card-head">
          <h3>Bảng chi tiết bán hàng (<span id="revDetailCount">0</span> mục)</h3>
          <div class="head-tools">
            <div class="search-mini">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input id="revDetailSearch" type="text" placeholder="Lọc nhanh sách, tác giả...">
            </div>
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Mã HĐ</th>
                <th>Thời gian</th>
                <th>Tên sách & Mã sách</th>
                <th>Tác giả</th>
                <th>Thể loại</th>
                <th>SL</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
                <th>Thanh toán</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
              </tr>
            </thead>
            <tbody id="revDetailTableBody">
              <!-- Injected by renderRevenueAnalytics() -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===================== TAB: LỊCH SỬ MUA HÀNG ===================== -->
    <section class="tab-panel" id="tab-invoices">
      <div class="page-head">
        <div>
          <p class="eyebrow">Báo cáo & Lịch sử</p>
          <h2>Lịch sử mua hàng</h2>
          <p>Toàn bộ danh sách 100+ đơn hàng đã bán từ quầy POS và hệ thống online với đủ mọi trạng thái.</p>
        </div>
      </div>

      <div class="perforation"><span></span><span></span><span></span><div class="rule"></div></div>

      <div class="section-card">
        <div class="section-card-head" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px;">
          <h3>Tất cả đơn hàng (<span id="adminInvoiceCount">0</span>)</h3>
          <div class="head-tools" style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
            <div class="search-mini">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input id="invoiceSearchInput" type="text" placeholder="Tìm mã đơn, tên khách, SĐT...">
            </div>
            <select id="invoiceStatusFilter" style="border:1px solid var(--line); border-radius:8px; padding:7px 12px; font-size:13px; outline:0; background:var(--paper); color:var(--ink); font-weight:500;">
              <option value="all">-- Tất cả trạng thái --</option>
              <option value="paid">Đã thanh toán (paid)</option>
              <option value="completed">Đã hoàn thành (completed)</option>
              <option value="unpaid">Chưa thanh toán (unpaid)</option>
              <option value="processing">Đang xử lý (processing)</option>
              <option value="shipping">Đang giao hàng (shipping)</option>
              <option value="overdue">Quá hạn (overdue)</option>
              <option value="cancelled">Đã hủy (cancelled)</option>
            </select>
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Mã HĐ</th>
                <th>Thời gian</th>
                <th>Khách hàng</th>
                <th>Phương thức</th>
                <th>Thành tiền</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
              </tr>
            </thead>
            <tbody id="adminInvoiceTableBody">
              <!-- Injected by fetchInvoices() -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

  </div>
</div>

<!-- ============ MODAL THÊM / SỬA SÁCH (TÍCH HỢP UPLOAD MULTIPLE IMAGES & FORMDATA) ============ -->
<div class="modal-overlay" id="bookModal">
  <div class="modal-card">
    <h3 id="modalTitle">Thêm sách mới</h3>
    <p class="sub" id="modalSub">Nhập đầy đủ thông tin sách để lưu vào cơ sở dữ liệu.</p>

    <form id="bookForm" class="modal-form" enctype="multipart/form-data">
      <input type="hidden" id="editBookId">
      <input type="hidden" id="mbCoverIndex" value="0">

      <div>
        <label for="mbBookCode">Mã sách (*)</label>
        <input type="text" id="mbBookCode" name="bookCode" placeholder="vd: SK-001" required>
      </div>

      <div>
        <label for="mbCategory">Thể loại (*)</label>
        <input type="text" id="mbCategory" name="category" placeholder="vd: Văn học, Kinh tế" required>
      </div>

      <div class="full">
        <label for="mbTitle">Tên sách (*)</label>
        <input type="text" id="mbTitle" name="title" placeholder="Nhập tên sách..." required>
      </div>

      <div class="full">
        <label for="mbAuthor">Tác giả (*)</label>
        <input type="text" id="mbAuthor" name="author" placeholder="Nhập tên tác giả..." required>
      </div>

      <div>
        <label for="mbPrice">Giá bán (VNĐ) (*)</label>
        <input type="number" id="mbPrice" name="price" min="0" placeholder="vd: 89000" required>
      </div>

      <div>
        <label for="mbStock">Số lượng tồn kho (*)</label>
        <input type="number" id="mbStock" name="stock" min="0" placeholder="vd: 50" required>
      </div>

      <div class="full">
        <label for="mbShelfLocation">Vị trí kệ</label>
        <input type="text" id="mbShelfLocation" name="shelfLocation" placeholder="vd: Kệ A-01">
      </div>

      <!-- CHECKBOX SLIDER NỔI BẬT & SLOGAN -->
      <div class="full" style="background:var(--navy-100); padding:12px 14px; border-radius:8px; border:1px solid var(--line);">
        <label style="display:flex; align-items:center; gap:8px; cursor:pointer; margin-bottom:0; font-size:13px; color:var(--navy-900);">
          <input type="checkbox" id="mbIsFeatured" name="isFeatured" style="width:16px; height:16px; accent-color:var(--gold); cursor:pointer;">
          <strong>Hiển thị làm Slider Nổi Bật Trang Chủ (isFeatured)</strong>
        </label>
        
        <div id="mbSloganGroup" style="display:none; margin-top:10px;">
          <label for="mbSlogan" style="font-size:11.5px; font-weight:600; color:var(--navy-700); margin-bottom:4px;">Slogan / Tiêu đề phụ</label>
          <input type="text" id="mbSlogan" name="slogan" placeholder="vd: Khơi nguồn cảm hứng & Đánh thức tâm hồn" style="background:var(--paper);">
        </div>
      </div>

      <!-- UPLOAD ẢNH (MULTER FORMDATA) -->
      <div class="full">
        <label for="mbImages">Hình ảnh sản phẩm (Tối đa 5 ảnh)</label>
        <input type="file" id="mbImages" name="images" multiple accept="image/*">
        <div style="font-size:11.5px; color:var(--muted); margin-top:4px;">💡 Bạn có thể chọn tối đa 5 file ảnh cùng lúc. Bấm vào ảnh preview để chọn làm <strong>Ảnh bìa</strong>.</div>
        <div class="preview-container" id="imagePreviewContainer"></div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn" onclick="closeBookModal()">Hủy</button>
        <button type="submit" class="btn btn-solid" id="saveBookBtn">Lưu sách</button>
      </div>
    </form>
  </div>
</div>



<!-- ============ MODAL XEM CHI TIẾT ĐƠN HÀNG ============ -->
<div class="modal-overlay" id="orderDetailModal">
  <div class="modal-card" style="max-width: 720px;">
    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
      <div>
        <h3 id="modalOrderCode" style="font-size:22px; font-weight:600; color:var(--navy-900);">Mã Đơn Hàng</h3>
        <p class="sub" id="modalOrderDate" style="font-size:12.5px; color:var(--muted); margin-bottom:12px;"></p>
      </div>
      <button class="btn btn-sm" onclick="closeOrderDetailModal()">✕ Đóng</button>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; background:var(--navy-100); padding:16px; border-radius:8px; margin-bottom:18px; font-size:13px;">
      <div>
        <div><strong>Khách hàng:</strong> <span id="modalCustomerName">--</span></div>
        <div style="margin-top:4px;"><strong>Số điện thoại:</strong> <span id="modalCustomerPhone">--</span></div>
        <div style="margin-top:4px;"><strong>Địa chỉ:</strong> <span id="modalCustomerAddress">--</span></div>
      </div>
      <div>
        <div><strong>Phương thức thanh toán:</strong> <span id="modalPaymentMethod">--</span></div>
        <div style="margin-top:4px; display:flex; align-items:center; gap:8px;">
          <strong>Trạng thái:</strong>
          <span id="modalStatusBadge"></span>
        </div>
        <div style="margin-top:8px; display:flex; align-items:center; gap:6px;">
          <label style="font-size:11.5px; font-weight:600; color:var(--navy-900);">Cập nhật trạng thái:</label>
          <select id="modalStatusSelect" onchange="changeInvoiceStatusFromModal()" style="font-size:12px; padding:4px 8px; border-radius:6px; border:1px solid var(--line);">
            <option value="paid">paid (Đã thanh toán)</option>
            <option value="completed">completed (Đã hoàn thành)</option>
            <option value="unpaid">unpaid (Chưa thanh toán)</option>
            <option value="processing">processing (Đang xử lý)</option>
            <option value="shipping">shipping (Đang giao hàng)</option>
            <option value="overdue">overdue (Quá hạn)</option>
            <option value="cancelled">cancelled (Đã hủy)</option>
          </select>
        </div>
      </div>
    </div>

    <h4 style="font-size:14px; font-weight:600; margin-bottom:10px; font-family:'Inter',sans-serif;">Danh sách sản phẩm mua:</h4>
    <div class="table-wrap" style="margin-bottom:16px;">
      <table style="min-width:100%;">
        <thead>
          <tr>
            <th>Mã sách</th>
            <th>Tên sản phẩm</th>
            <th style="text-align:right;">Đơn giá</th>
            <th style="text-align:center;">Số lượng</th>
            <th style="text-align:right;">Thành tiền</th>
          </tr>
        </thead>
        <tbody id="modalItemsTableBody">
          <!-- Injected items -->
        </tbody>
      </table>
    </div>

    <div style="background:var(--cream); padding:14px 18px; border-radius:8px; border:1px solid var(--line); font-size:13.5px; display:flex; flex-direction:column; gap:6px; align-items:flex-end;">
      <div>Tổng tiền hàng: <strong id="modalTotalAmount">0₫</strong></div>
      <div>Giảm giá: <strong id="modalDiscount" style="color:var(--danger);">0₫</strong></div>
      <div style="font-size:16px; font-weight:700; color:var(--navy-900); margin-top:4px;">Thực thanh toán: <span id="modalFinalAmount" style="color:var(--gold-dark); font-family:'IBM Plex Mono',monospace;">0₫</span></div>
    </div>

    <div class="modal-actions" style="margin-top:20px;">
      <button class="btn btn-solid" onclick="closeOrderDetailModal()">Đóng cửa sổ</button>
    </div>
  </div>
</div>

<!-- ============ MODAL THÊM NHÂN VIÊN MỚI ============ -->
<div class="modal-overlay" id="staffModal">
  <div class="modal-card">
    <h3>Thêm nhân viên mới</h3>
    <p class="sub">Tạo tài khoản và phân quyền cho nhân sự trong hệ thống.</p>

    <form id="staffForm" class="modal-form">
      <div class="full">
        <label for="staffName">Họ và tên (*)</label>
        <input type="text" id="staffName" name="name" placeholder="Nhập họ và tên nhân viên..." required>
      </div>

      <div>
        <label for="staffEmail">Email (*)</label>
        <input type="email" id="staffEmail" name="email" placeholder="vd: nhanvien@lamour.vn" required>
      </div>

      <div>
        <label for="staffPhone">Số điện thoại (*)</label>
        <input type="tel" id="staffPhone" name="phone" placeholder="vd: 0912345678" pattern="^0\d{8,9}$" title="Bắt đầu bằng 0, độ dài 9-10 số" required>
      </div>

      <div>
        <label for="staffPassword">Mật khẩu khởi tạo (*)</label>
        <input type="password" id="staffPassword" name="password" placeholder="Tối thiểu 6 ký tự..." minlength="6" required>
      </div>

      <div>
        <label for="staffRole">Phân quyền / Vai trò (*)</label>
        <select id="staffRole" name="role" required>
          <option value="staff">Nhân viên Bán hàng / Thu ngân (POS)</option>
          <option value="stock">Nhân viên Kho hàng / Logistics</option>
          <option value="accountant">Bộ phận Kế toán - Tài chính</option>
          <option value="admin">Quản trị viên hệ thống</option>
        </select>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn" onclick="closeStaffModal()">Hủy</button>
        <button type="submit" class="btn btn-solid">Lưu nhân viên</button>
      </div>
    </form>
  </div>
</div>

<script>
  // ---------- GLOBAL CUSTOM TOAST & CONFIRM SYSTEM ----------
  function showCustomToast(type = 'info', title = '', message = '') {
    let container = document.getElementById('toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'toast-container';
      document.body.appendChild(container);
    }
    const icons = { success: '✓', error: '✕', warning: '!', info: 'i' };
    const defaultTitles = { success: 'Thành công!', error: 'Có lỗi xảy ra!', warning: 'Cảnh báo!', info: 'Thông báo' };
    const toast = document.createElement('div');
    toast.className = `custom-toast toast-${type}`;
    toast.innerHTML = `
      <div class="toast-icon">${icons[type] || 'i'}</div>
      <div class="toast-content">
        <div class="toast-title">${title || defaultTitles[type] || 'Thông báo'}</div>
        <div class="toast-msg">${message}</div>
      </div>
      <button class="toast-close" onclick="this.parentElement.remove()">✕</button>
      <div class="toast-progress"></div>
    `;
    container.appendChild(toast);
    setTimeout(() => {
      if (toast.parentElement) {
        toast.classList.add('hide');
        setTimeout(() => toast.remove(), 300);
      }
    }, 3000);
  }

  function showCustomConfirm(message = 'Bạn có chắc chắn muốn thực hiện thao tác này?') {
    return new Promise((resolve) => {
      let overlay = document.getElementById('custom-confirm-overlay');
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.id = 'custom-confirm-overlay';
        overlay.className = 'confirm-overlay';
        overlay.innerHTML = `
          <div class="confirm-modal">
            <div class="confirm-icon">?</div>
            <div class="confirm-title">Xác nhận thao tác</div>
            <div class="confirm-msg" id="custom-confirm-msg"></div>
            <div class="confirm-actions">
              <button class="confirm-btn" id="custom-confirm-cancel">Hủy bỏ</button>
              <button class="confirm-btn confirm-btn-primary" id="custom-confirm-ok">Đồng ý</button>
            </div>
          </div>
        `;
        document.body.appendChild(overlay);
      }
      document.getElementById('custom-confirm-msg').textContent = message;
      overlay.classList.add('active');
      const okBtn = document.getElementById('custom-confirm-ok');
      const cancelBtn = document.getElementById('custom-confirm-cancel');
      const cleanup = () => {
        overlay.classList.remove('active');
        okBtn.removeEventListener('click', onOk);
        cancelBtn.removeEventListener('click', onCancel);
      };
      const onOk = () => { cleanup(); resolve(true); };
      const onCancel = () => { cleanup(); resolve(false); };
      okBtn.addEventListener('click', onOk);
      cancelBtn.addEventListener('click', onCancel);
    });
  }

  const fmt = n => (n || 0).toLocaleString('vi-VN') + '₫';

  function formatDateTime(dateString) {
    if (!dateString) return '--';
    const date = new Date(dateString);
    if (isNaN(date.getTime())) return '--';
    return date.toLocaleString('vi-VN', {
      timeZone: 'Asia/Ho_Chi_Minh',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour12: false
    });
  }

  // ============ DỮ LIỆU NHÂN VIÊN THẬT (FETCH API GET /api/users?role=staff,admin) ============
  let allStaffData = [];

  const roleLabel = { admin: "Quản trị", manager: "Quản lý", staff: "Nhân viên", cashier: "Thu ngân", stock: "Kho hàng", accountant: "Kế toán" };
  const roleClass = { admin: "role-manager", manager: "role-manager", staff: "role-cashier", cashier: "role-cashier", stock: "role-stock", accountant: "role-stock" };

  function initials(name){
    if (!name) return 'NV';
    const parts = name.trim().split(' ');
    if (parts.length === 1) return parts[0][0] || 'NV';
    return (parts[parts.length-2]?.[0] || '') + (parts[parts.length-1]?.[0] || '');
  }

  function staffRowHtml(s){
    const isActive = Boolean(s.isActive);
    const code = 'NV-' + (s._id ? s._id.slice(-4).toUpperCase() : '000');
    const safeName = (s.name || 'Chưa đặt tên').replace(/'/g, "\\'");

    return `
      <tr>
        <td class="id-cell">${code}</td>
        <td>
          <div class="person-cell">
            <span class="av">${initials(s.name).toUpperCase()}</span>
            <div>
              <div class="nm">${s.name || 'Chưa đặt tên'}</div>
              <div style="font-size:11px; color:var(--muted);">${s.email || ''} ${s.phone ? '• ' + s.phone : ''}</div>
            </div>
          </div>
        </td>
        <td><span class="badge ${roleClass[s.role] || 'role-cashier'}">${roleLabel[s.role] || s.role}</span></td>
        <td><span class="badge ${isActive ? 'active-s' : 'locked-s'}">${isActive ? 'Hoạt động' : 'Đã khóa'}</span></td>
        <td>
          <div class="row-actions">
            <button class="${isActive ? 'danger' : 'unlock'}" onclick="toggleLock('${s._id}', '${safeName}', ${isActive})">
              ${isActive ? 'Khóa tài khoản' : 'Mở khóa'}
            </button>
          </div>
        </td>
      </tr>
    `;
  }

  function renderStaffTables(list){
    const overviewTbody = document.getElementById('staffTableBodyOverview');
    const fullTbody = document.getElementById('staffTableBodyFull');
    const staffCountEl = document.getElementById('staffCount');

    if (staffCountEl) staffCountEl.textContent = list.length;

    if (!list || list.length === 0) {
      const emptyHtml = `
        <tr>
          <td colspan="5" style="text-align:center; padding: 24px; color: var(--muted);">
            Chưa có nhân viên nào trong hệ thống.
          </td>
        </tr>
      `;
      if (overviewTbody) overviewTbody.innerHTML = emptyHtml;
      if (fullTbody) fullTbody.innerHTML = emptyHtml;
      return;
    }

    const html = list.map(staffRowHtml).join('');
    if (overviewTbody) overviewTbody.innerHTML = html;
    if (fullTbody) fullTbody.innerHTML = html;
  }

  async function fetchStaff() {
    try {
      const response = await fetch('/api/users?role=staff,admin,stock,accountant');
      const result = await response.json();

      if (response.ok && result.success) {
        allStaffData = result.data || [];
        renderStaffTables(allStaffData);
      } else {
        console.error('Không thể tải danh sách nhân viên:', result.message);
      }
    } catch (error) {
      console.error('Lỗi khi gọi API fetchStaff:', error);
    }
  }

  // ============ ĐIỀU KHIỂN MODAL & THÊM NHÂN VIÊN MỚI ============
  function openStaffModal() {
    const form = document.getElementById('staffForm');
    if (form) form.reset();
    const modal = document.getElementById('staffModal');
    if (modal) modal.classList.add('active');
  }

  function closeStaffModal() {
    const modal = document.getElementById('staffModal');
    if (modal) modal.classList.remove('active');
    const form = document.getElementById('staffForm');
    if (form) form.reset();
  }

  const staffForm = document.getElementById('staffForm');
  if (staffForm) {
    staffForm.addEventListener('submit', async function (e) {
      e.preventDefault();

      const name = document.getElementById('staffName').value.trim();
      const email = document.getElementById('staffEmail').value.trim();
      const phone = document.getElementById('staffPhone').value.trim();
      const password = document.getElementById('staffPassword').value;
      const role = document.getElementById('staffRole').value;

      // Validate số điện thoại hợp lệ (Regex /^0\d{8,9}$/)
      const phoneRegex = /^0\d{8,9}$/;
      if (!phoneRegex.test(phone)) {
        showCustomToast('error', 'Thất bại', 'Số điện thoại không hợp lệ! Vui lòng nhập số bắt đầu bằng 0 và có độ dài 9-10 chữ số.');
        return;
      }

      try {
        const response = await fetch('/api/users', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ name, email, phone, password, role })
        });

        const result = await response.json();

        if (response.ok && result.success) {
          showCustomToast('success', 'Thành công', 'Đã thêm nhân viên mới thành công!');
          closeStaffModal();
          fetchStaff();
        } else {
          showCustomToast('error', 'Thất bại', result.message || 'Thêm nhân viên thất bại');
        }
      } catch (error) {
        console.error('Lỗi khi gửi yêu cầu thêm nhân viên:', error);
        showCustomToast('error', 'Thất bại', 'Đã có lỗi kết nối xảy ra khi thêm nhân viên.');
      }
    });
  }

  // Đóng modal khi click ra ngoài overlay
  const staffModalEl = document.getElementById('staffModal');
  if (staffModalEl) {
    staffModalEl.addEventListener('click', function (e) {
      if (e.target === this) {
        closeStaffModal();
      }
    });
  }

  async function toggleLock(id, name, isCurrentActive) {
    const actionText = isCurrentActive ? 'khóa' : 'mở khóa';
    if (!await showCustomConfirm(`Bạn có chắc chắn muốn ${actionText} tài khoản của "${name}"?`)) {
      return;
    }

    try {
      const response = await fetch(`/api/users/${id}/lock`, {
        method: 'PUT'
      });
      const result = await response.json();

      if (response.ok && result.success) {
        showCustomToast('success', 'Thành công', result.message || `Đã ${actionText} tài khoản thành công!`);
        fetchStaff();
      } else {
        showCustomToast('error', 'Thất bại', result.message || 'Thao tác không thành công.');
      }
    } catch (error) {
      console.error('Lỗi khi khóa/mở khóa tài khoản:', error);
      showCustomToast('error', 'Lỗi kết nối', 'Đã xảy ra lỗi kết nối với máy chủ.');
    }
  }

  // ============ DỮ LIỆU SÁCH THẬT (FETCH API TỪ DATABASE) ============
  let allBooksData = [];

  function stockBadge(stock){
    if(stock === 0) return `<span class="badge stock-out">Hết hàng</span>`;
    if(stock <= 10) return `<span class="badge stock-low">Sắp hết</span>`;
    return `<span class="badge stock-ok">Còn hàng</span>`;
  }

  function renderBooks(list){
    const tbody = document.getElementById('bookTableBody');
    document.getElementById('bookHeaderCount').textContent = `${list.length} đầu sách`;

    if(!list || list.length === 0){
      tbody.innerHTML = `
        <tr>
          <td colspan="10" style="text-align:center; padding: 32px; color: var(--muted);">
            Chưa có cuốn sách nào trong cơ sở dữ liệu. Vui lòng bấm <strong>"+ Thêm sách mới"</strong> để bắt đầu.
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = list.map(b => {
      const coverUrl = b.coverImage || (b.images && b.images[0]) || '';
      const thumbHtml = coverUrl
        ? `<img src="${coverUrl}" class="book-thumb-small" alt="${b.title}">`
        : `<div class="book-thumb-small" style="display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--muted);">No Img</div>`;

      return `
        <tr>
          <td>${thumbHtml}</td>
          <td class="id-cell">${b.bookCode}</td>
          <td style="font-weight:600; color:var(--navy-900);">${b.title} ${b.isFeatured ? '<span class="badge" style="background:var(--gold-100);color:var(--gold-dark);font-size:9.5px;padding:2px 7px;margin-left:4px;">★ Slider</span>' : ''}</td>
          <td>${b.author}</td>
          <td><span class="mono" style="font-size:12px; color:var(--navy-700);">${b.category || '—'}</span></td>
          <td class="mono">${b.stock}</td>
          <td class="amount">${fmt(b.price)}</td>
          <td class="mono" style="font-size:12px;">${b.shelfLocation || 'Chưa xếp'}</td>
          <td>${stockBadge(b.stock)}</td>
          <td>
            <div class="row-actions">
              <button onclick="editBook('${b._id}')">Chỉnh sửa</button>
              <button class="danger" onclick="deleteBook('${b._id}', '${b.title.replace(/'/g, "\\'")}')">Xoá</button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  async function fetchBooks() {
    try {
      const response = await fetch('/api/books');
      const result = await response.json();

      if (response.ok && result.success) {
        allBooksData = result.data || [];
        renderBooks(allBooksData);
        
        const totalStock = allBooksData.reduce((sum, item) => sum + (item.stock || 0), 0);
        document.getElementById('kpiTotalBooks').textContent = `${totalStock.toLocaleString('vi-VN')} cuốn`;

        if (typeof populateRevenueFilterDropdowns === 'function') {
          populateRevenueFilterDropdowns();
        }
        if (typeof applyRevenueFilter === 'function' && allInvoicesData.length > 0) {
          applyRevenueFilter();
        }
      } else {
        console.error('Không thể tải dữ liệu sách:', result.message);
      }
    } catch (error) {
      console.error('Lỗi khi gọi API fetchBooks:', error);
    }
  }

  document.getElementById('bookSearch').addEventListener('input', (e) => {
    const q = e.target.value.trim().toLowerCase();
    const filtered = allBooksData.filter(b => 
      (b.title && b.title.toLowerCase().includes(q)) || 
      (b.author && b.author.toLowerCase().includes(q)) ||
      (b.bookCode && b.bookCode.toLowerCase().includes(q)) ||
      (b.category && b.category.toLowerCase().includes(q))
    );
    renderBooks(filtered);
  });

  async function deleteBook(id, bookTitle) {
    if (!await showCustomConfirm(`Bạn có chắc chắn muốn xóa cuốn sách "${bookTitle}" khỏi hệ thống?`)) {
      return;
    }

    try {
      const response = await fetch(`/api/books/${id}`, {
        method: 'DELETE'
      });

      const result = await response.json();

      if (response.ok && result.success) {
        showCustomToast('success', 'Thành công', 'Đã xóa sách thành công!');
        fetchBooks();
      } else {
        showCustomToast('error', 'Thất bại', result.message || 'Xóa sách thất bại.');
      }
    } catch (error) {
      console.error('Lỗi khi xóa sách:', error);
      showCustomToast('error', 'Lỗi hệ thống', 'Đã xảy ra lỗi khi kết nối tới máy chủ.');
    }
  }

  // ---------- MODAL THÊM / SỬA SÁCH (LOGIC ĐỌC VÀ CHỌN ÁNH BÌA) ----------
  let selectedCoverIndex = 0;
  const imageInput = document.getElementById('mbImages');
  const previewContainer = document.getElementById('imagePreviewContainer');
  const coverIndexInput = document.getElementById('mbCoverIndex');

  if (imageInput) {
    imageInput.addEventListener('change', handleImageSelect);
  }

  function handleImageSelect() {
    previewContainer.innerHTML = '';
    selectedCoverIndex = 0;
    coverIndexInput.value = 0;

    const files = Array.from(imageInput.files).slice(0, 5);

    if (files.length === 0) return;

    files.forEach((file, index) => {
      const reader = new FileReader();
      reader.onload = function (e) {
        const thumb = document.createElement('div');
        thumb.className = 'preview-thumb' + (index === selectedCoverIndex ? ' is-cover' : '');
        thumb.dataset.index = index;

        thumb.innerHTML = `
          <img src="${e.target.result}" alt="Preview ${index + 1}">
          <div class="badge-cover">${index === selectedCoverIndex ? '★ Ảnh bìa' : 'Chọn làm bìa'}</div>
        `;

        thumb.addEventListener('click', () => {
          selectedCoverIndex = index;
          coverIndexInput.value = index;
          updateCoverBadges();
        });

        previewContainer.appendChild(thumb);
      };
      reader.readAsDataURL(file);
    });
  }

  function updateCoverBadges() {
    const thumbs = previewContainer.querySelectorAll('.preview-thumb');
    thumbs.forEach((thumb, idx) => {
      const isCover = idx === selectedCoverIndex;
      thumb.classList.toggle('is-cover', isCover);
      const badge = thumb.querySelector('.badge-cover');
      if (badge) {
        badge.textContent = isCover ? '★ Ảnh bìa' : 'Chọn làm bìa';
      }
    });
  }

  function openBookModal() {
    document.getElementById('editBookId').value = '';
    document.getElementById('modalTitle').textContent = 'Thêm sách mới';
    document.getElementById('modalSub').textContent = 'Nhập đầy đủ thông tin sách và tải lên hình ảnh.';
    document.getElementById('bookForm').reset();
    document.getElementById('mbIsFeatured').checked = false;
    document.getElementById('mbSlogan').value = '';
    document.getElementById('mbSloganGroup').style.display = 'none';
    previewContainer.innerHTML = '';
    selectedCoverIndex = 0;
    coverIndexInput.value = 0;
    document.getElementById('bookModal').classList.add('active');
  }

  function closeBookModal() {
    document.getElementById('bookModal').classList.remove('active');
  }

  // Lắng nghe sự kiện bật/tắt checkbox isFeatured
  const mbIsFeatured = document.getElementById('mbIsFeatured');
  if (mbIsFeatured) {
    mbIsFeatured.addEventListener('change', () => {
      document.getElementById('mbSloganGroup').style.display = mbIsFeatured.checked ? 'block' : 'none';
    });
  }

  function editBook(id) {
    const book = allBooksData.find(b => b._id === id);
    if (!book) return;

    document.getElementById('editBookId').value = book._id;
    document.getElementById('mbBookCode').value = book.bookCode || '';
    document.getElementById('mbCategory').value = book.category || '';
    document.getElementById('mbTitle').value = book.title || '';
    document.getElementById('mbAuthor').value = book.author || '';
    document.getElementById('mbPrice').value = book.price || 0;
    document.getElementById('mbStock').value = book.stock || 0;
    document.getElementById('mbShelfLocation').value = book.shelfLocation || '';
    
    const isFeat = Boolean(book.isFeatured);
    document.getElementById('mbIsFeatured').checked = isFeat;
    document.getElementById('mbSlogan').value = book.slogan || '';
    document.getElementById('mbSloganGroup').style.display = isFeat ? 'block' : 'none';

    previewContainer.innerHTML = '';
    selectedCoverIndex = 0;
    coverIndexInput.value = 0;

    const currentImages = [];
    if (book.coverImage) currentImages.push(book.coverImage);
    if (book.images && Array.isArray(book.images)) {
      book.images.forEach(img => {
        if (img && img !== book.coverImage) currentImages.push(img);
      });
    }

    if (currentImages.length > 0) {
      currentImages.forEach((imgUrl, idx) => {
        const thumb = document.createElement('div');
        thumb.className = 'preview-thumb' + (idx === 0 ? ' is-cover' : '');
        thumb.innerHTML = `
          <img src="${imgUrl}" alt="Current ${idx + 1}">
          <div class="badge-cover">${idx === 0 ? '★ Ảnh bìa hiện tại' : 'Ảnh phụ'}</div>
        `;
        previewContainer.appendChild(thumb);
      });
    }

    document.getElementById('modalTitle').textContent = 'Chỉnh sửa thông tin sách';
    document.getElementById('modalSub').textContent = `Đang chỉnh sửa: ${book.title}`;
    document.getElementById('bookModal').classList.add('active');
  }

  // SUBMIT FORM BẰNG FORMDATA
  document.getElementById('bookForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const editId = document.getElementById('editBookId').value;
    const isEdit = Boolean(editId);
    const url = isEdit ? `/api/books/${editId}` : '/api/books';
    const method = isEdit ? 'PUT' : 'POST';

    const formData = new FormData();
    formData.append('bookCode', document.getElementById('mbBookCode').value.trim());
    formData.append('category', document.getElementById('mbCategory').value.trim());
    formData.append('title', document.getElementById('mbTitle').value.trim());
    formData.append('author', document.getElementById('mbAuthor').value.trim());
    formData.append('price', document.getElementById('mbPrice').value);
    formData.append('stock', document.getElementById('mbStock').value);
    formData.append('shelfLocation', document.getElementById('mbShelfLocation').value.trim());
    formData.append('isFeatured', document.getElementById('mbIsFeatured').checked);
    formData.append('slogan', document.getElementById('mbSlogan').value.trim());
    formData.append('coverIndex', selectedCoverIndex);

    const files = document.getElementById('mbImages').files;
    for (let i = 0; i < Math.min(files.length, 5); i++) {
      formData.append('images', files[i]);
    }

    const saveBtn = document.getElementById('saveBookBtn');
    saveBtn.disabled = true;
    saveBtn.textContent = 'Đang lưu...';

    try {
      const response = await fetch(url, {
        method: method,
        body: formData
      });

      const result = await response.json();

      if (response.ok && result.success) {
        showCustomToast('success', 'Thành công', isEdit ? 'Cập nhật sách thành công!' : 'Thêm sách mới thành công!');
        closeBookModal();
        fetchBooks();
      } else {
        showCustomToast('error', 'Lưu thất bại', result.message || 'Lưu dữ liệu không thành công.');
      }
    } catch (error) {
      console.error('Lỗi khi lưu sách:', error);
      showCustomToast('error', 'Lỗi kết nối', 'Đã xảy ra lỗi kết nối máy chủ.');
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Lưu sách';
    }
  });

  // ============ DỮ LIỆU HÓA ĐƠN THẬT (FETCH API GET /api/invoices) ============
  let allInvoicesData = [];
  let currentSelectedInvoiceId = null;

  const invoiceStatusBadgeMap = {
    paid: { class: 'badge stock-ok', text: 'Đã thanh toán' },
    completed: { class: 'badge stock-ok', text: 'Đã hoàn thành' },
    unpaid: { class: 'badge stock-low', text: 'Chưa thanh toán' },
    processing: { class: 'badge role-cashier', text: 'Đang xử lý' },
    shipping: { class: 'badge active-s', text: 'Đang giao hàng' },
    overdue: { class: 'badge stock-out', text: 'Quá hạn' },
    cancelled: { class: 'badge locked-s', text: 'Đã hủy' }
  };

  async function fetchInvoices() {
    try {
      const response = await fetch('/api/invoices');
      const result = await response.json();

      if (response.ok && result.success) {
        allInvoicesData = result.data || [];
        updateOverviewKPIs(allInvoicesData);
        populateRevenueFilterDropdowns();
        applyRevenueFilter();
        filterAdminInvoices();
      } else {
        console.error('Không thể tải dữ liệu hóa đơn:', result.message);
      }
    } catch (error) {
      console.error('Lỗi khi gọi API fetchInvoices:', error);
    }
  }

  function filterAdminInvoices() {
    const query = (document.getElementById('invoiceSearchInput')?.value || '').trim().toLowerCase();
    const selectedStatus = document.getElementById('invoiceStatusFilter')?.value || 'all';

    let filtered = allInvoicesData.filter(inv => {
      const matchSearch = !query || 
        (inv.invoiceCode && inv.invoiceCode.toLowerCase().includes(query)) ||
        (inv.customerName && inv.customerName.toLowerCase().includes(query)) ||
        (inv.customerPhone && inv.customerPhone.toLowerCase().includes(query));

      const matchStatus = selectedStatus === 'all' || inv.status === selectedStatus;

      return matchSearch && matchStatus;
    });

    renderAdminInvoices(filtered);
  }

  function renderAdminInvoices(invoicesList) {
    const tbody = document.getElementById('adminInvoiceTableBody');
    const countEl = document.getElementById('adminInvoiceCount');
    if (countEl) countEl.textContent = invoicesList.length;
    if (!tbody) return;

    if (invoicesList.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:24px; color:var(--muted);">Chưa có đơn hàng nào phù hợp bộ lọc.</td></tr>`;
      return;
    }

    const payMethodMap = { cash: 'Tiền mặt', transfer: 'Chuyển khoản', card: 'Thẻ POS', pos: 'Thẻ POS', COD: 'COD' };

    tbody.innerHTML = invoicesList.map(inv => {
      const stInfo = invoiceStatusBadgeMap[inv.status] || { class: 'badge stock-low', text: inv.status };

      return `
        <tr>
          <td class="id-cell">${inv.invoiceCode}</td>
          <td class="mono" style="font-size:12px; color:var(--muted);">${formatDateTime(inv.createdAt)}</td>
          <td style="font-weight:600;">${inv.customerName || 'Khách lẻ'}</td>
          <td><span class="mono" style="font-size:12px;">${payMethodMap[inv.paymentMethod] || inv.paymentMethod}</span></td>
          <td class="amount">${fmt(inv.finalAmount)}</td>
          <td><span class="${stInfo.class}">${stInfo.text}</span></td>
          <td>
            <button class="btn btn-sm" onclick="openOrderDetailModal('${inv._id}')">Chi tiết</button>
          </td>
        </tr>
      `;
    }).join('');
  }

  function openOrderDetailModal(invoiceId) {
    const inv = allInvoicesData.find(i => i._id === invoiceId);
    if (!inv) return;

    currentSelectedInvoiceId = invoiceId;
    const modal = document.getElementById('orderDetailModal');
    if (!modal) return;

    document.getElementById('modalOrderCode').textContent = inv.invoiceCode;
    document.getElementById('modalOrderDate').textContent = `Thời gian tạo: ${formatDateTime(inv.createdAt)}`;
    document.getElementById('modalCustomerName').textContent = inv.customerName || 'Khách lẻ';
    document.getElementById('modalCustomerPhone').textContent = inv.customerPhone || 'Chưa cung cấp';
    document.getElementById('modalCustomerAddress').textContent = inv.customerAddress || 'Tại quầy POS';

    const payMethodMap = { cash: 'Tiền mặt', transfer: 'Chuyển khoản banking', card: 'Thẻ ATM / POS', pos: 'Thẻ POS', COD: 'COD' };
    document.getElementById('modalPaymentMethod').textContent = payMethodMap[inv.paymentMethod] || inv.paymentMethod;

    const stInfo = invoiceStatusBadgeMap[inv.status] || { class: 'badge stock-low', text: inv.status };
    document.getElementById('modalStatusBadge').innerHTML = `<span class="${stInfo.class}">${stInfo.text}</span>`;
    
    const statusSelect = document.getElementById('modalStatusSelect');
    if (statusSelect) statusSelect.value = inv.status;

    // Render items table
    const itemsTbody = document.getElementById('modalItemsTableBody');
    if (itemsTbody) {
      if (!inv.items || inv.items.length === 0) {
        itemsTbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:12px; color:var(--muted);">Không có danh sách sản phẩm.</td></tr>`;
      } else {
        itemsTbody.innerHTML = inv.items.map(it => {
          const bookObj = getResolvedBook(it.book);
          const title = bookObj.title || 'Sách đã mua';
          const code = bookObj.bookCode || 'N/A';
          const author = (bookObj.author && bookObj.author !== 'Tác giả chưa rõ') ? ` <span style="font-size:11.5px; color:var(--muted); font-weight:normal;">(${bookObj.author})</span>` : '';
          const price = (typeof it.price === 'number' && it.price > 0) ? it.price : (bookObj.price || 0);
          const qty = it.quantity || 1;
          const lineTotal = price * qty;

          return `
            <tr>
              <td class="mono" style="font-size:12px;">${code}</td>
              <td style="font-weight:600;">${title}${author}</td>
              <td style="text-align:right;" class="mono">${fmt(price)}</td>
              <td style="text-align:center;" class="mono">x${qty}</td>
              <td style="text-align:right;" class="amount">${fmt(lineTotal)}</td>
            </tr>
          `;
        }).join('');
      }
    }

    document.getElementById('modalTotalAmount').textContent = fmt(inv.totalAmount || inv.finalAmount);
    document.getElementById('modalDiscount').textContent = fmt(inv.discount || 0);
    document.getElementById('modalFinalAmount').textContent = fmt(inv.finalAmount);

    modal.classList.add('active');
  }

  function closeOrderDetailModal() {
    const modal = document.getElementById('orderDetailModal');
    if (modal) modal.classList.remove('active');
  }

  async function changeInvoiceStatusFromModal() {
    if (!currentSelectedInvoiceId) return;
    const newStatus = document.getElementById('modalStatusSelect').value;

    try {
      const res = await fetch(`/api/invoices/${currentSelectedInvoiceId}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showCustomToast('success', 'Thành công', `Đã cập nhật trạng thái đơn thành ${newStatus}`);
        fetchInvoices();
        closeOrderDetailModal();
      } else {
        showCustomToast('error', 'Lỗi', data.message || 'Không thể cập nhật trạng thái đơn');
      }
    } catch (err) {
      console.error('Lỗi khi cập nhật trạng thái đơn:', err);
      showCustomToast('error', 'Lỗi kết nối', 'Không thể kết nối máy chủ');
    }
  }

  function updateOverviewKPIs(invoicesList) {
    const now = new Date();
    const currentMonth = now.getMonth();
    const currentYear = now.getFullYear();

    const paidInvoices = invoicesList.filter(inv => inv.status === 'paid' || inv.status === 'completed');
    const thisMonthPaidInvoices = paidInvoices.filter(inv => {
      const d = new Date(inv.createdAt);
      return d.getMonth() === currentMonth && d.getFullYear() === currentYear;
    });

    const monthRevenue = thisMonthPaidInvoices.reduce((sum, inv) => sum + (inv.finalAmount || 0), 0);
    const totalPaidRevenue = paidInvoices.reduce((sum, inv) => sum + (inv.finalAmount || 0), 0);

    const revenueDisplay = monthRevenue > 0 ? monthRevenue : totalPaidRevenue;
    const revEl = document.getElementById('kpiTotalRevenue');
    if (revEl) revEl.textContent = fmt(revenueDisplay);

    const ordersEl = document.getElementById('kpiTotalOrders');
    if (ordersEl) ordersEl.textContent = `${invoicesList.length} đơn`;

    const pendingOrders = invoicesList.filter(inv => ['pending_payment', 'unpaid', 'delivering', 'shipping', 'processing'].includes(inv.status));
    const pendingAmount = pendingOrders.reduce((sum, inv) => sum + (inv.finalAmount || 0), 0);

    const pendingCountEl = document.getElementById('kpiPendingDeliveryOrders');
    if (pendingCountEl) pendingCountEl.textContent = `${pendingOrders.length} đơn`;

    const pendingAmtEl = document.getElementById('kpiPendingDeliveryAmount');
    if (pendingAmtEl) pendingAmtEl.textContent = fmt(pendingAmount);
  }

  // ============ PHÂN HỆ THỐNG KÊ DOANH THU & PHÂN TÍCH ĐA CHIỀU ============
  let currentFilteredRevenueItems = [];

  // Helper hàm tra cứu và giải quyết thông tin sách từ allBooksData và items
  function getResolvedBook(bookRef) {
    if (!bookRef) {
      return {
        _id: '',
        bookCode: 'MS-000',
        title: 'Sách đã mua',
        author: 'Đang cập nhật',
        category: 'Khác',
        price: 0,
        coverImage: ''
      };
    }

    const isObj = typeof bookRef === 'object';
    const bookId = isObj ? (bookRef._id ? String(bookRef._id) : '') : String(bookRef);
    const bookCode = isObj ? (bookRef.bookCode || '') : '';

    // Tìm cuốn sách tương ứng trong allBooksData
    const foundInAllBooks = allBooksData.find(bk => 
      (bookId && String(bk._id) === bookId) || 
      (bookCode && bk.bookCode === bookCode)
    ) || {};

    const author = (isObj && bookRef.author && bookRef.author.trim() && bookRef.author !== 'Tác giả chưa rõ')
      ? bookRef.author.trim()
      : (foundInAllBooks.author || 'Tác giả chưa rõ');

    const title = (isObj && bookRef.title && bookRef.title.trim())
      ? bookRef.title.trim()
      : (foundInAllBooks.title || 'Sách đã mua');

    const code = (isObj && bookRef.bookCode && bookRef.bookCode.trim())
      ? bookRef.bookCode.trim()
      : (foundInAllBooks.bookCode || 'MS-000');

    const category = (isObj && bookRef.category && bookRef.category.trim())
      ? bookRef.category.trim()
      : (foundInAllBooks.category || 'Khác');

    const price = (isObj && typeof bookRef.price === 'number' && bookRef.price > 0)
      ? bookRef.price
      : (foundInAllBooks.price || 0);

    const coverImage = (isObj && bookRef.coverImage)
      ? bookRef.coverImage
      : (foundInAllBooks.coverImage || (foundInAllBooks.images && foundInAllBooks.images[0]) || '');

    return {
      _id: bookId || (foundInAllBooks._id ? String(foundInAllBooks._id) : ''),
      bookCode: code,
      title: title,
      author: author,
      category: category,
      price: price,
      coverImage: coverImage
    };
  }

  function populateRevenueFilterDropdowns() {
    // 1. Danh sách tác giả
    const authorSelect = document.getElementById('revAuthorFilter');
    if (authorSelect) {
      const currentVal = authorSelect.value;
      const authorsSet = new Set();
      allBooksData.forEach(b => { if (b.author && b.author.trim()) authorsSet.add(b.author.trim()); });
      allInvoicesData.forEach(inv => {
        (inv.items || []).forEach(it => {
          const b = getResolvedBook(it.book);
          if (b.author && b.author.trim() && b.author !== 'Tác giả chưa rõ') {
            authorsSet.add(b.author.trim());
          }
        });
      });
      const sortedAuthors = Array.from(authorsSet).sort((a, b) => a.localeCompare(b, 'vi'));
      authorSelect.innerHTML = `<option value="all">-- Tất cả tác giả (${sortedAuthors.length}) --</option>` +
        sortedAuthors.map(a => `<option value="${a}" ${a === currentVal ? 'selected' : ''}>${a}</option>`).join('');
    }

    // 2. Danh sách cuốn sách
    const bookSelect = document.getElementById('revBookFilter');
    if (bookSelect) {
      const currentVal = bookSelect.value;
      const booksMap = new Map();
      allBooksData.forEach(b => {
        booksMap.set(String(b._id), `${b.bookCode || 'MS'} - ${b.title}`);
      });
      allInvoicesData.forEach(inv => {
        (inv.items || []).forEach(it => {
          const b = getResolvedBook(it.book);
          if (b._id && !booksMap.has(b._id)) {
            booksMap.set(b._id, `${b.bookCode || 'MS'} - ${b.title}`);
          }
        });
      });
      bookSelect.innerHTML = `<option value="all">-- Tất cả cuốn sách (${booksMap.size}) --</option>` +
        Array.from(booksMap.entries()).map(([id, name]) => `<option value="${id}" ${id === currentVal ? 'selected' : ''}>${name}</option>`).join('');
    }

    // 3. Danh sách thể loại
    const catSelect = document.getElementById('revCategoryFilter');
    if (catSelect) {
      const currentVal = catSelect.value;
      const catSet = new Set();
      allBooksData.forEach(b => { if (b.category && b.category.trim()) catSet.add(b.category.trim()); });
      allInvoicesData.forEach(inv => {
        (inv.items || []).forEach(it => {
          const b = getResolvedBook(it.book);
          if (b.category && b.category.trim()) {
            catSet.add(b.category.trim());
          }
        });
      });
      const sortedCats = Array.from(catSet).sort((a, b) => a.localeCompare(b, 'vi'));
      catSelect.innerHTML = `<option value="all">-- Tất cả thể loại (${sortedCats.length}) --</option>` +
        sortedCats.map(c => `<option value="${c}" ${c === currentVal ? 'selected' : ''}>${c}</option>`).join('');
    }
  }

  function setRevenueQuickRange(rangeType) {
    document.querySelectorAll('.quick-pill').forEach(btn => {
      btn.classList.remove('active');
    });
    if (event && event.target && event.target.classList.contains('quick-pill')) {
      event.target.classList.add('active');
    }

    const startInput = document.getElementById('revStartDate');
    const endInput = document.getElementById('revEndDate');
    if (!startInput || !endInput) return;

    const now = new Date();
    const formatDateInput = (d) => {
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    if (rangeType === 'today') {
      startInput.value = formatDateInput(now);
      endInput.value = formatDateInput(now);
    } else if (rangeType === '7days') {
      const past = new Date(now.getTime() - 6 * 24 * 60 * 60 * 1000);
      startInput.value = formatDateInput(past);
      endInput.value = formatDateInput(now);
    } else if (rangeType === '30days') {
      const past = new Date(now.getTime() - 29 * 24 * 60 * 60 * 1000);
      startInput.value = formatDateInput(past);
      endInput.value = formatDateInput(now);
    } else if (rangeType === 'thisMonth') {
      const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
      const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);
      startInput.value = formatDateInput(firstDay);
      endInput.value = formatDateInput(lastDay);
    } else if (rangeType === 'thisYear') {
      startInput.value = `${now.getFullYear()}-01-01`;
      endInput.value = `${now.getFullYear()}-12-31`;
    } else {
      // all
      startInput.value = '';
      endInput.value = '';
    }

    applyRevenueFilter();
  }

  function resetRevenueFilter() {
    const startInput = document.getElementById('revStartDate');
    const endInput = document.getElementById('revEndDate');
    if (startInput) startInput.value = '';
    if (endInput) endInput.value = '';

    const authorSelect = document.getElementById('revAuthorFilter');
    if (authorSelect) authorSelect.value = 'all';

    const bookSelect = document.getElementById('revBookFilter');
    if (bookSelect) bookSelect.value = 'all';

    const catSelect = document.getElementById('revCategoryFilter');
    if (catSelect) catSelect.value = 'all';

    const paySelect = document.getElementById('revPaymentFilter');
    if (paySelect) paySelect.value = 'all';

    const statusSelect = document.getElementById('revStatusFilter');
    if (statusSelect) statusSelect.value = 'paid_completed';

    document.querySelectorAll('.quick-pill').forEach((btn, idx) => {
      btn.classList.toggle('active', btn.textContent.includes('Toàn thời gian'));
    });

    applyRevenueFilter();
  }

  function applyRevenueFilter() {
    const startDateVal = document.getElementById('revStartDate')?.value;
    const endDateVal = document.getElementById('revEndDate')?.value;
    const selectedAuthor = document.getElementById('revAuthorFilter')?.value || 'all';
    const selectedBookId = document.getElementById('revBookFilter')?.value || 'all';
    const selectedCategory = document.getElementById('revCategoryFilter')?.value || 'all';
    const selectedPayment = document.getElementById('revPaymentFilter')?.value || 'all';
    const selectedStatus = document.getElementById('revStatusFilter')?.value || 'paid_completed';

    let startTime = startDateVal ? new Date(`${startDateVal}T00:00:00.000`).getTime() : 0;
    let endTime = endDateVal ? new Date(`${endDateVal}T23:59:59.999`).getTime() : Infinity;

    // Lọc danh sách hóa đơn
    const filteredInvoices = allInvoicesData.filter(inv => {
      const invTime = new Date(inv.createdAt).getTime();
      if (invTime < startTime || invTime > endTime) return false;

      if (selectedStatus === 'paid_completed') {
        if (inv.status !== 'paid' && inv.status !== 'completed') return false;
      } else if (selectedStatus !== 'all') {
        if (inv.status !== selectedStatus) return false;
      }

      if (selectedPayment !== 'all') {
        if (inv.paymentMethod !== selectedPayment) return false;
      }

      // Kiểm tra xem hóa đơn có chứa sách/tác giả/thể loại phù hợp không
      const hasMatchingItem = (inv.items || []).some(it => {
        const b = getResolvedBook(it.book);
        const matchAuthor = selectedAuthor === 'all' || (b.author && b.author.trim() === selectedAuthor);
        const matchBook = selectedBookId === 'all' || b._id === selectedBookId || b.bookCode === selectedBookId;
        const matchCategory = selectedCategory === 'all' || (b.category && b.category.trim() === selectedCategory);
        return matchAuthor && matchBook && matchCategory;
      });

      if (!hasMatchingItem) return false;

      return true;
    });

    renderRevenueAnalytics(filteredInvoices, {
      startDateVal,
      endDateVal,
      selectedAuthor,
      selectedBookId,
      selectedCategory,
      selectedPayment,
      selectedStatus
    });
  }

  function renderRevenueAnalytics(filteredInvoices, filterContext = {}) {
    const { selectedAuthor = 'all', selectedBookId = 'all', selectedCategory = 'all', startDateVal, endDateVal } = filterContext;

    // 1. Phân tích chi tiết từng mặt hàng khớp bộ lọc
    const matchedDetailItems = [];
    let totalRevenueCalculated = 0;
    let totalBooksQuantitySold = 0;
    const uniqueBookIdsSet = new Set();
    const authorsMap = new Map();
    const booksMap = new Map();
    const categoryRevenueMap = new Map();
    const paymentRevenueMap = new Map();

    filteredInvoices.forEach(inv => {
      const pMethod = inv.paymentMethod || 'cash';
      paymentRevenueMap.set(pMethod, (paymentRevenueMap.get(pMethod) || 0) + (inv.finalAmount || 0));

      (inv.items || []).forEach(it => {
        const b = getResolvedBook(it.book);
        const bookIdStr = b._id || b.bookCode || 'unknown';
        const bAuthor = b.author;
        const bTitle = b.title;
        const bCode = b.bookCode;
        const bCategory = b.category;
        const bCover = b.coverImage;
        const qty = it.quantity || 1;
        const price = (typeof it.price === 'number' && it.price > 0) ? it.price : (b.price || 0);
        const itemLineTotal = price * qty;

        const matchAuthor = selectedAuthor === 'all' || (bAuthor && bAuthor.trim() === selectedAuthor);
        const matchBook = selectedBookId === 'all' || bookIdStr === selectedBookId || bCode === selectedBookId;
        const matchCat = selectedCategory === 'all' || (bCategory && bCategory.trim() === selectedCategory);

        if (matchAuthor && matchBook && matchCat) {
          totalRevenueCalculated += itemLineTotal;
          totalBooksQuantitySold += qty;
          uniqueBookIdsSet.add(bookIdStr);

          // Thống kê Tác giả (loại trừ nếu tác giả trống)
          const authorKey = bAuthor && bAuthor !== 'Tác giả chưa rõ' ? bAuthor : (b.title ? `Tác giả (${b.title})` : 'Tác giả');
          const currAuth = authorsMap.get(authorKey) || { name: authorKey, rev: 0, qty: 0 };
          currAuth.rev += itemLineTotal;
          currAuth.qty += qty;
          authorsMap.set(authorKey, currAuth);

          // Thống kê Cuốn sách
          const currBook = booksMap.get(bookIdStr) || {
            id: bookIdStr,
            code: bCode,
            title: bTitle,
            author: bAuthor,
            coverImage: bCover,
            rev: 0,
            qty: 0
          };
          currBook.rev += itemLineTotal;
          currBook.qty += qty;
          booksMap.set(bookIdStr, currBook);

          // Thống kê Thể loại
          categoryRevenueMap.set(bCategory, (categoryRevenueMap.get(bCategory) || 0) + itemLineTotal);

          // Thêm vào bảng kê chi tiết
          matchedDetailItems.push({
            invoiceId: inv._id,
            invoiceCode: inv.invoiceCode,
            createdAt: inv.createdAt,
            bookCode: bCode,
            bookTitle: bTitle,
            author: bAuthor,
            category: bCategory,
            quantity: qty,
            price: price,
            lineTotal: itemLineTotal,
            paymentMethod: inv.paymentMethod,
            status: inv.status
          });
        }
      });
    });

    currentFilteredRevenueItems = matchedDetailItems;

    // 2. Cập nhật các thẻ KPI
    const totalInvoicesCount = filteredInvoices.length;
    const aov = totalInvoicesCount > 0 ? Math.round(totalRevenueCalculated / totalInvoicesCount) : 0;

    const totalSystemRevenue = allInvoicesData
      .filter(i => i.status === 'paid' || i.status === 'completed')
      .reduce((sum, i) => sum + (i.finalAmount || 0), 0);

    const percentOfAll = totalSystemRevenue > 0
      ? ((totalRevenueCalculated / totalSystemRevenue) * 100).toFixed(1)
      : 100;

    const statRevTotalEl = document.getElementById('statRevTotal');
    if (statRevTotalEl) statRevTotalEl.textContent = fmt(totalRevenueCalculated);

    const statRevPercentEl = document.getElementById('statRevPercentOfAll');
    if (statRevPercentEl) {
      statRevPercentEl.textContent = totalSystemRevenue > 0
        ? `Chiếm ${percentOfAll}% tổng doanh thu toàn hệ thống`
        : `Dữ liệu lọc thực tế`;
    }

    const statRevOrdersEl = document.getElementById('statRevOrders');
    if (statRevOrdersEl) statRevOrdersEl.textContent = `${totalInvoicesCount} đơn`;

    const completedInvoicesCount = filteredInvoices.filter(i => i.status === 'paid' || i.status === 'completed').length;
    const completedRate = totalInvoicesCount > 0 ? Math.round((completedInvoicesCount / totalInvoicesCount) * 100) : 100;
    const statRateEl = document.getElementById('statRevCompletedRate');
    if (statRateEl) statRateEl.textContent = `Tỷ lệ hoàn thành: ${completedRate}% (${completedInvoicesCount}/${totalInvoicesCount})`;

    const statBooksSoldEl = document.getElementById('statRevBooksSold');
    if (statBooksSoldEl) statBooksSoldEl.textContent = `${totalBooksQuantitySold.toLocaleString('vi-VN')} cuốn`;

    const statUniqueEl = document.getElementById('statRevUniqueBooks');
    if (statUniqueEl) statUniqueEl.textContent = `${uniqueBookIdsSet.size} đầu sách khác nhau`;

    const statAOVEl = document.getElementById('statRevAOV');
    if (statAOVEl) statAOVEl.textContent = fmt(aov);

    // 3. Xây dựng Biểu đồ Cột Động
    const chartEl = document.getElementById('barChart');
    const chartBadge = document.getElementById('chartPeriodBadge');
    const chartSubLabel = document.getElementById('chartSubLabel');
    let isDayView = false;

    // Xác định vẽ theo ngày hay theo tháng
    if (startDateVal && endDateVal) {
      const d1 = new Date(startDateVal);
      const d2 = new Date(endDateVal);
      const diffDays = Math.ceil((d2 - d1) / (1000 * 60 * 60 * 24)) + 1;
      if (diffDays <= 31 && diffDays > 0) {
        isDayView = true;
      }
    }

    let chartData = [];
    if (isDayView) {
      const d1 = new Date(startDateVal);
      const d2 = new Date(endDateVal);
      const daysCount = Math.ceil((d2 - d1) / (1000 * 60 * 60 * 24)) + 1;
      const dayTotals = {};

      for (let i = 0; i < daysCount; i++) {
        const curDate = new Date(d1.getTime() + i * 24 * 60 * 60 * 1000);
        const key = `${String(curDate.getDate()).padStart(2, '0')}/${String(curDate.getMonth() + 1).padStart(2, '0')}`;
        dayTotals[key] = { label: key, fullDate: curDate.toLocaleDateString('vi-VN'), val: 0, count: 0 };
      }

      matchedDetailItems.forEach(item => {
        const d = new Date(item.createdAt);
        const key = `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}`;
        if (dayTotals[key]) {
          dayTotals[key].val += item.lineTotal;
          dayTotals[key].count += 1;
        }
      });

      chartData = Object.values(dayTotals);
      if (chartBadge) chartBadge.textContent = `Theo ngày (${chartData.length} ngày)`;
      if (chartSubLabel) chartSubLabel.textContent = `Doanh thu chi tiết từng ngày từ ${startDateVal} đến ${endDateVal}`;
    } else {
      // Theo 12 Tháng
      const monthlyTotals = Array.from({ length: 12 }, (_, idx) => ({
        label: `T${idx + 1}`,
        fullDate: `Tháng ${idx + 1}/2026`,
        val: 0,
        count: 0
      }));

      matchedDetailItems.forEach(item => {
        const d = new Date(item.createdAt);
        const monthIdx = d.getMonth();
        if (monthlyTotals[monthIdx]) {
          monthlyTotals[monthIdx].val += item.lineTotal;
          monthlyTotals[monthIdx].count += 1;
        }
      });

      chartData = monthlyTotals;
      if (chartBadge) chartBadge.textContent = '12 Tháng (2026)';
      if (chartSubLabel) chartSubLabel.textContent = 'Tổng hợp doanh thu các tháng theo tiêu chí lọc';
    }

    const maxChartVal = Math.max(...chartData.map(c => c.val), 1);
    let peakItem = chartData.reduce((prev, curr) => (curr.val > prev.val ? curr : prev), { val: 0, label: 'N/A' });

    if (chartEl) {
      if (chartData.length === 0 || maxChartVal === 0) {
        chartEl.innerHTML = `<div style="margin:auto; color:var(--muted); font-size:13px;">Không có dữ liệu doanh thu trong khoảng thời gian này.</div>`;
      } else {
        chartEl.innerHTML = chartData.map(r => `
          <div class="bar-col">
            <div class="bar ${r.val === peakItem.val && r.val > 0 ? 'peak' : ''}" style="height:${r.val > 0 ? Math.max((r.val / maxChartVal * 100), 8).toFixed(1) : 4}%;">
              <span class="bar-tooltip">${r.fullDate || r.label}: ${r.val.toLocaleString('vi-VN')}₫ (${r.count} mục)</span>
            </div>
            <span class="m-label">${r.label}</span>
          </div>
        `).join('');
      }
    }

    const statPeakEl = document.getElementById('statRevPeak');
    if (statPeakEl) statPeakEl.textContent = fmt(peakItem.val);
    const statPeakLblEl = document.getElementById('statRevPeakLabel');
    if (statPeakLblEl) statPeakLblEl.textContent = peakItem.val > 0 ? `Đỉnh điểm: ${peakItem.fullDate || peakItem.label}` : 'Chưa có doanh thu';

    // 4. Cơ cấu theo Thể loại sách
    const catContainer = document.getElementById('revCategoryBreakdown');
    if (catContainer) {
      const sortedCats = Array.from(categoryRevenueMap.entries()).sort((a, b) => b[1] - a[1]);
      if (sortedCats.length === 0) {
        catContainer.innerHTML = `<div style="font-size:12px; color:var(--muted);">Chưa có dữ liệu thể loại.</div>`;
      } else {
        const catColors = ['#1E3A5F', '#C7A15A', '#0D9488', '#D97706', '#6366F1', '#EC4899', '#8B5CF6'];
        catContainer.innerHTML = sortedCats.slice(0, 5).map(([catName, catVal], idx) => {
          const pct = totalRevenueCalculated > 0 ? ((catVal / totalRevenueCalculated) * 100).toFixed(1) : 0;
          const color = catColors[idx % catColors.length];
          return `
            <div class="ratio-bar-wrap">
              <div class="ratio-head">
                <span class="name">${catName}</span>
                <span class="amount">${fmt(catVal)} <span style="font-size:11px; color:var(--muted); font-weight:normal;">(${pct}%)</span></span>
              </div>
              <div class="ratio-progress">
                <div class="ratio-fill" style="width:${pct}%; background:${color};"></div>
              </div>
            </div>
          `;
        }).join('');
      }
    }

    // 5. Cơ cấu theo Phương thức thanh toán
    const payContainer = document.getElementById('revPaymentBreakdown');
    if (payContainer) {
      const payNames = { cash: 'Tiền mặt tại quầy', transfer: 'Chuyển khoản banking', card: 'Thẻ ATM / POS' };
      const payColors = { cash: '#059669', transfer: '#2563EB', card: '#D97706' };
      const totalPay = Array.from(paymentRevenueMap.values()).reduce((a, b) => a + b, 0);

      payContainer.innerHTML = ['cash', 'transfer', 'card'].map(pKey => {
        const pVal = paymentRevenueMap.get(pKey) || 0;
        const pct = totalPay > 0 ? ((pVal / totalPay) * 100).toFixed(1) : 0;
        return `
          <div class="ratio-bar-wrap">
            <div class="ratio-head">
              <span class="name">${payNames[pKey]}</span>
              <span class="amount">${fmt(pVal)} <span style="font-size:11px; color:var(--muted); font-weight:normal;">(${pct}%)</span></span>
            </div>
            <div class="ratio-progress">
              <div class="ratio-fill" style="width:${pct}%; background:${payColors[pKey]};"></div>
            </div>
          </div>
        `;
      }).join('');
    }

    // 6. Top 5 Tác giả doanh thu cao nhất
    const topAuthorsEl = document.getElementById('topAuthorsList');
    if (topAuthorsEl) {
      const sortedAuthors = Array.from(authorsMap.values()).sort((a, b) => b.rev - a.rev).slice(0, 5);
      if (sortedAuthors.length === 0) {
        topAuthorsEl.innerHTML = `<div style="padding:20px; text-align:center; color:var(--muted); font-size:13px;">Không có tác giả phù hợp.</div>`;
      } else {
        const topAuthMax = sortedAuthors[0].rev || 1;
        topAuthorsEl.innerHTML = sortedAuthors.map((item, idx) => `
          <div class="rank-item">
            <div class="rank-badge rank-${idx + 1}">#${idx + 1}</div>
            <div class="rank-info">
              <div class="rank-title">${item.name}</div>
              <div class="rank-sub">
                <span>Đã bán: <strong>${item.qty}</strong> cuốn</span>
              </div>
              <div class="rank-progress">
                <div class="rank-bar" style="width:${Math.round((item.rev / topAuthMax) * 100)}%;"></div>
              </div>
            </div>
            <div class="rank-val">${fmt(item.rev)}</div>
          </div>
        `).join('');
      }
    }

    // 7. Top 5 Cuốn sách bán chạy nhất
    const topBooksEl = document.getElementById('topBooksList');
    if (topBooksEl) {
      const sortedBooks = Array.from(booksMap.values()).sort((a, b) => b.rev - a.rev).slice(0, 5);
      if (sortedBooks.length === 0) {
        topBooksEl.innerHTML = `<div style="padding:20px; text-align:center; color:var(--muted); font-size:13px;">Không có sách phù hợp.</div>`;
      } else {
        const topBookMax = sortedBooks[0].rev || 1;
        topBooksEl.innerHTML = sortedBooks.map((item, idx) => `
          <div class="rank-item">
            <div class="rank-badge rank-${idx + 1}">#${idx + 1}</div>
            ${item.coverImage ? `<img src="${item.coverImage}" class="book-thumb-small" style="width:28px; height:38px;" alt="${item.title}">` : ''}
            <div class="rank-info">
              <div class="rank-title" title="${item.title}">${item.title}</div>
              <div class="rank-sub">
                <span>${item.code}</span>
                <span>•</span>
                <span>TG: ${item.author}</span>
                <span>•</span>
                <span>Bán: <strong>${item.qty}</strong></span>
              </div>
              <div class="rank-progress">
                <div class="rank-bar" style="width:${Math.round((item.rev / topBookMax) * 100)}%;"></div>
              </div>
            </div>
            <div class="rank-val">${fmt(item.rev)}</div>
          </div>
        `).join('');
      }
    }

    // 8. Bảng chi tiết danh sách bán hàng theo bộ lọc
    renderRevenueDetailTable(matchedDetailItems);
  }

  function renderRevenueDetailTable(items) {
    const tbody = document.getElementById('revDetailTableBody');
    const countEl = document.getElementById('revDetailCount');
    if (countEl) countEl.textContent = items.length;
    if (!tbody) return;

    if (items.length === 0) {
      tbody.innerHTML = `<tr><td colspan="11" style="text-align:center; padding:24px; color:var(--muted);">Không có mục bán hàng nào khớp bộ lọc.</td></tr>`;
      return;
    }

    const payMethodMap = { cash: 'Tiền mặt', transfer: 'Chuyển khoản', card: 'Thẻ POS', pos: 'Thẻ POS', COD: 'COD' };

    // Giới hạn hiển thị 150 dòng để mượt mà
    const displayList = items.slice(0, 150);

    tbody.innerHTML = displayList.map(item => {
      const stInfo = invoiceStatusBadgeMap[item.status] || { class: 'badge stock-low', text: item.status };

      return `
        <tr>
          <td class="id-cell">${item.invoiceCode}</td>
          <td class="mono" style="font-size:12px; color:var(--muted); white-space:nowrap;">${formatDateTime(item.createdAt)}</td>
          <td>
            <div style="font-weight:600; color:var(--navy-900);">${item.bookTitle}</div>
            <span class="mono" style="font-size:11px; color:var(--muted);">${item.bookCode}</span>
          </td>
          <td>${item.author}</td>
          <td><span class="mono" style="font-size:11.5px; color:var(--navy-700);">${item.category}</span></td>
          <td style="text-align:center; font-weight:600;" class="mono">${item.quantity}</td>
          <td class="mono" style="font-size:12px;">${fmt(item.price)}</td>
          <td class="amount">${fmt(item.lineTotal)}</td>
          <td><span class="mono" style="font-size:11.5px;">${payMethodMap[item.paymentMethod] || item.paymentMethod}</span></td>
          <td><span class="${stInfo.class}">${stInfo.text}</span></td>
          <td>
            <button class="btn btn-sm" onclick="openOrderDetailModal('${item.invoiceId}')">Chi tiết</button>
          </td>
        </tr>
      `;
    }).join('') + (items.length > 150 ? `<tr><td colspan="11" style="text-align:center; padding:12px; color:var(--muted); font-size:12px;">Đang hiển thị 150 / ${items.length} dòng dữ liệu. Sử dụng tính năng "Xuất CSV" để tải toàn bộ.</td></tr>` : '');
  }

  // TÌM KIẾM NHANH TRÊN BẢNG CHI TIẾT DOANH THU
  document.getElementById('revDetailSearch')?.addEventListener('input', (e) => {
    const q = e.target.value.trim().toLowerCase();
    if (!q) {
      renderRevenueDetailTable(currentFilteredRevenueItems);
      return;
    }
    const filtered = currentFilteredRevenueItems.filter(item => 
      item.invoiceCode.toLowerCase().includes(q) ||
      item.bookTitle.toLowerCase().includes(q) ||
      item.bookCode.toLowerCase().includes(q) ||
      item.author.toLowerCase().includes(q) ||
      item.category.toLowerCase().includes(q)
    );
    renderRevenueDetailTable(filtered);
  });

  // XUẤT BÁO CÁO DOANH THU SANG CSV (UTF-8 EXCEL)
  function exportRevenueCSV() {
    if (!currentFilteredRevenueItems || currentFilteredRevenueItems.length === 0) {
      showCustomToast('warning', 'Không có dữ liệu', 'Không có mục dữ liệu nào để xuất báo cáo.');
      return;
    }

    const payMethodMap = { cash: 'Tiền mặt', transfer: 'Chuyển khoản', card: 'Thẻ POS', pos: 'Thẻ POS', COD: 'COD' };
    const statusMap = { paid: 'Đã thanh toán', completed: 'Đã hoàn thành', unpaid: 'Chưa thanh toán', processing: 'Đang xử lý', shipping: 'Đang giao', overdue: 'Quá hạn', cancelled: 'Đã hủy' };

    const headers = ['Mã HĐ', 'Thời gian tạo', 'Mã sách', 'Tên sách', 'Tác giả', 'Thể loại', 'Số lượng', 'Đơn giá (VNĐ)', 'Thành tiền (VNĐ)', 'Phương thức', 'Trạng thái'];
    
    const rows = currentFilteredRevenueItems.map(item => [
      `"${item.invoiceCode}"`,
      `"${formatDateTime(item.createdAt)}"`,
      `"${item.bookCode}"`,
      `"${(item.bookTitle || '').replace(/"/g, '""')}"`,
      `"${(item.author || '').replace(/"/g, '""')}"`,
      `"${(item.category || '').replace(/"/g, '""')}"`,
      item.quantity,
      item.price,
      item.lineTotal,
      `"${payMethodMap[item.paymentMethod] || item.paymentMethod}"`,
      `"${statusMap[item.status] || item.status}"`
    ]);

    const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\r\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    const nowStr = new Date().toISOString().slice(0, 10);
    link.setAttribute('href', url);
    link.setAttribute('download', `bao-cao-doanh-thu-lamour-${nowStr}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

    showCustomToast('success', 'Xuất file thành công', `Đã xuất ${currentFilteredRevenueItems.length} mục ra file Excel CSV!`);
  }

  // ============ DỮ LIỆU TÁC GIẢ (FETCH API GET /api/authors) ============
  let allAuthorsData = [];

  function renderAuthors(list) {
    const tbody = document.getElementById('authorTableBody');
    const headerCount = document.getElementById('authorHeaderCount');
    if (headerCount) headerCount.textContent = `${list.length} tác giả`;

    if (!list || list.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" style="text-align:center; padding: 32px; color: var(--muted);">
            Chưa có tác giả nào trong hệ thống. Bấm <strong>"+ Thêm tác giả"</strong> để tạo mới.
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = list.map(a => {
      const avatarHtml = a.avatar
        ? `<img src="${a.avatar}" style="width:40px; height:40px; border-radius:50%; object-fit:cover; border:1.5px solid var(--gold);" alt="${a.name}">`
        : `<div style="width:40px; height:40px; border-radius:50%; background:linear-gradient(135deg, var(--gold), var(--navy-700)); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-family:'Fraunces',serif; font-size:14px;">${a.name ? a.name.charAt(0).toUpperCase() : 'A'}</div>`;

      return `
        <tr>
          <td>${avatarHtml}</td>
          <td style="font-weight:600; color:var(--navy-900); font-size:14px;">${a.name}</td>
          <td><span class="mono" style="font-size:12px; color:var(--gold-dark); font-weight:600;">${a.genre || '—'}</span></td>
          <td style="font-style:italic; color:var(--muted); font-size:12.5px; max-width:320px;">${a.quote ? '“' + a.quote + '”' : '—'}</td>
          <td class="mono" style="font-weight:600;">${a.bookCount || 0} tác phẩm</td>
          <td>
            <div class="row-actions">
              <button onclick="editAuthor('${a._id}')">Chỉnh sửa</button>
              <button class="danger" onclick="deleteAuthor('${a._id}', '${a.name.replace(/'/g, "\\'")}')">Xóa</button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  // ============ CMS QUẢN LÝ TRANG CHỦ ============
  let currentSiteSettings = null;
  let currentHeroBanners = [];
  let currentBannerIndex = 0;
  let bannerFileMap = {};

  function renderSingleBannerForm(index) {
    const container = document.getElementById('bannersContainer');
    if (!container) return;

    if (!currentHeroBanners || currentHeroBanners.length === 0) {
      currentHeroBanners = [
        { image: '', badge: '', title: '', description: '', linkUrl: '/products' }
      ];
    }

    if (index < 0) index = 0;
    if (index >= currentHeroBanners.length) index = currentHeroBanners.length - 1;
    currentBannerIndex = index;

    const b = currentHeroBanners[currentBannerIndex] || {};
    const total = currentHeroBanners.length;
    const currentImg = (bannerFileMap[currentBannerIndex] ? URL.createObjectURL(bannerFileMap[currentBannerIndex]) : b.image) || 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=1920&q=80';

    container.innerHTML = `
      <div style="background:#FAF8F5; border:1px solid var(--line); border-radius:12px; padding:22px; display:flex; flex-direction:column; gap:16px; box-shadow:0 4px 16px rgba(10,25,48,0.04);">
        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--line); padding-bottom:12px; flex-wrap:wrap; gap:10px;">
          <div style="font-weight:700; color:var(--navy-900); font-size:15px; display:flex; align-items:center; gap:8px;">
            <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:var(--gold);"></span>
            <span>Chỉnh sửa Slide Banner #${currentBannerIndex + 1}</span>
            <span class="mono badge active-s">Slide ${currentBannerIndex + 1} / ${total}</span>
          </div>
          <div style="display:flex; gap:8px; align-items:center;">
            <button type="button" class="btn btn-sm" onclick="addNewBanner()">+ Thêm Banner</button>
            <button type="button" class="btn btn-sm danger" onclick="removeCurrentBanner()">🗑 Xóa</button>
          </div>
        </div>

        <div>
          <label style="font-size:12px; font-weight:600; color:var(--navy-900); display:block; margin-bottom:6px;">Ảnh xem trước hiện tại</label>
          <div style="width:100%; height:200px; border-radius:8px; overflow:hidden; border:1px solid var(--line); background:var(--navy-900); display:flex; align-items:center; justify-content:center;">
            <img class="banner-preview" id="bannerPreviewImg" src="${currentImg}" alt="Banner Preview" style="width:100%; height:100%; object-fit:cover;">
          </div>
        </div>

        <div>
          <label style="font-size:12px; font-weight:600; color:var(--navy-900); display:block; margin-bottom:6px;">Tải lên ảnh Banner mới</label>
          <input type="file" class="banner-input-file" id="bannerInputFile" accept="image/*" style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13px; background:#fff;">
          <small style="color:var(--muted); font-size:11px; margin-top:4px; display:block;">Hỗ trợ định dạng: JPG, PNG, WEBP, GIF (Tối đa 5MB). Để trống nếu giữ ảnh hiện tại.</small>
        </div>

        <div>
          <label style="font-size:12px; font-weight:600; color:var(--navy-900); display:block; margin-bottom:6px;">Tiêu đề Slide (*)</label>
          <input type="text" id="bannerInputTitle" value="${(b.title || '').replace(/"/g, '&quot;')}" placeholder="VD: Một chương mới đang chờ được lật mở" required style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13.5px; font-weight:600;">
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
          <div>
            <label style="font-size:12px; font-weight:600; color:var(--navy-900); display:block; margin-bottom:6px;">Badge (Tag nhỏ)</label>
            <input type="text" id="bannerInputBadge" value="${(b.badge || '').replace(/"/g, '&quot;')}" placeholder="VD: ✦ KIỆT TÁC THỜI GIAN" style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13px;">
          </div>
          <div>
            <label style="font-size:12px; font-weight:600; color:var(--navy-900); display:block; margin-bottom:6px;">Link trỏ tới</label>
            <input type="text" id="bannerInputLink" value="${(b.linkUrl || '/products').replace(/"/g, '&quot;')}" placeholder="/products" style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13px;">
          </div>
        </div>

        <div>
          <label style="font-size:12px; font-weight:600; color:var(--navy-900); display:block; margin-bottom:6px;">Mô tả / Slogan</label>
          <textarea id="bannerInputDesc" rows="2" placeholder="Mô tả ngắn cho tác phẩm trên banner..." style="width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:6px; font-size:13px; font-family:inherit;">${b.description || ''}</textarea>
        </div>

        <!-- Navigation Bar -->
        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px; padding-top:14px; border-top:1px solid var(--line);">
          <button type="button" class="btn" onclick="prevBanner()" ${currentBannerIndex === 0 ? 'disabled style="opacity:0.4; cursor:not-allowed;"' : ''}>❮ Trước</button>
          <span class="mono" style="font-weight:700; font-size:13px; color:var(--navy-900);">Banner ${currentBannerIndex + 1}/${total}</span>
          <button type="button" class="btn btn-gold" onclick="saveAndNextBanner()">Lưu & Tiếp theo ❯</button>
        </div>
      </div>
    `;

    const fileInput = document.getElementById('bannerInputFile');
    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
          bannerFileMap[currentBannerIndex] = file;
          const previewImg = document.getElementById('bannerPreviewImg');
          if (previewImg) {
            previewImg.src = URL.createObjectURL(file);
          }
        }
      });
    }
  }

  function addNewBanner() {
    syncCurrentBannerFromForm();
    currentHeroBanners.push({ image: '', badge: '', title: '', description: '', linkUrl: '/products' });
    currentBannerIndex = currentHeroBanners.length - 1;
    renderSingleBannerForm(currentBannerIndex);
    showCustomToast('info', 'Thêm Banner', `Đã thêm Banner #${currentBannerIndex + 1}. Hãy cập nhật thông tin.`);
  }

  async function removeCurrentBanner() {
    if (currentHeroBanners.length <= 1) {
      showCustomToast('warning', 'Không thể xóa', 'Hệ thống cần duy trì tối thiểu 1 banner.');
      return;
    }
    if (await showCustomConfirm(`Bạn có chắc chắn muốn xóa Slide Banner #${currentBannerIndex + 1}?`)) {
      currentHeroBanners.splice(currentBannerIndex, 1);
      
      const newFileMap = {};
      Object.keys(bannerFileMap).forEach(key => {
        const k = parseInt(key, 10);
        if (k < currentBannerIndex) {
          newFileMap[k] = bannerFileMap[k];
        } else if (k > currentBannerIndex) {
          newFileMap[k - 1] = bannerFileMap[k];
        }
      });
      bannerFileMap = newFileMap;

      if (currentBannerIndex >= currentHeroBanners.length) {
        currentBannerIndex = currentHeroBanners.length - 1;
      }
      await saveSettingsInternal(false);
      renderSingleBannerForm(currentBannerIndex);
      showCustomToast('success', 'Đã xóa', 'Đã xóa banner thành công!');
    }
  }

  function syncCurrentBannerFromForm() {
    if (!currentHeroBanners[currentBannerIndex]) return;
    const titleEl = document.getElementById('bannerInputTitle');
    const badgeEl = document.getElementById('bannerInputBadge');
    const linkEl = document.getElementById('bannerInputLink');
    const descEl = document.getElementById('bannerInputDesc');
    const fileEl = document.getElementById('bannerInputFile');

    if (titleEl) currentHeroBanners[currentBannerIndex].title = titleEl.value.trim();
    if (badgeEl) currentHeroBanners[currentBannerIndex].badge = badgeEl.value.trim();
    if (linkEl) currentHeroBanners[currentBannerIndex].linkUrl = linkEl.value.trim() || '/products';
    if (descEl) currentHeroBanners[currentBannerIndex].description = descEl.value.trim();
    if (fileEl && fileEl.files && fileEl.files[0]) {
      bannerFileMap[currentBannerIndex] = fileEl.files[0];
    }
  }

  function prevBanner() {
    if (currentBannerIndex > 0) {
      syncCurrentBannerFromForm();
      currentBannerIndex--;
      renderSingleBannerForm(currentBannerIndex);
    }
  }

  async function saveAndNextBanner() {
    syncCurrentBannerFromForm();
    await saveSettingsInternal(false);
    if (currentBannerIndex < (currentHeroBanners.length - 1)) {
      currentBannerIndex++;
    }
    renderSingleBannerForm(currentBannerIndex);
  }

  function collectContactData() {
    return {
      phone: document.getElementById('cfgContactPhone')?.value.trim() || '',
      email: document.getElementById('cfgContactEmail')?.value.trim() || '',
      time: document.getElementById('cfgContactTime')?.value.trim() || '',
      address1: document.getElementById('cfgContactAddress1')?.value.trim() || '',
      address2: document.getElementById('cfgContactAddress2')?.value.trim() || ''
    };
  }

  function collectSocialData() {
    return {
      zalo: document.getElementById('cfgSocialZalo')?.value.trim() || '',
      messenger: document.getElementById('cfgSocialMessenger')?.value.trim() || '',
      facebook: document.getElementById('cfgSocialFacebook')?.value.trim() || '',
      instagram: document.getElementById('cfgSocialInstagram')?.value.trim() || '',
      tiktok: document.getElementById('cfgSocialTiktok')?.value.trim() || ''
    };
  }

  function collectFooterData() {
    return {
      aboutText: document.getElementById('cfgFooterAbout')?.value.trim() || '',
      copyright: document.getElementById('cfgFooterCopyright')?.value.trim() || ''
    };
  }

  async function saveSettingsInternal(showFullToast = true) {
    syncCurrentBannerFromForm();

    const formData = new FormData();
    formData.append('heroBanners', JSON.stringify(currentHeroBanners));
    formData.append('contact', JSON.stringify(collectContactData()));
    formData.append('social', JSON.stringify(collectSocialData()));
    formData.append('footer', JSON.stringify(collectFooterData()));

    Object.keys(bannerFileMap).forEach(idx => {
      if (bannerFileMap[idx]) {
        formData.append('bannerImage_' + idx, bannerFileMap[idx]);
      }
    });

    try {
      const res = await fetch('/api/settings', {
        method: 'PUT',
        body: formData
      });
      const result = await res.json();
      if (res.ok && result.success) {
        currentSiteSettings = result.data || {};
        if (currentSiteSettings.heroBanners) {
          currentHeroBanners = currentSiteSettings.heroBanners;
        }
        bannerFileMap = {};
        if (showFullToast) {
          showCustomToast('success', 'Thành công', 'Đã lưu cấu hình Trang Chủ (CMS) thành công!');
        } else {
          showCustomToast('success', 'Đã lưu', `Đã lưu Banner #${currentBannerIndex + 1} thành công!`);
        }
        return true;
      } else {
        showCustomToast('error', 'Thất bại', result.message || 'Không thể lưu cấu hình.');
        return false;
      }
    } catch (err) {
      console.error(err);
      showCustomToast('error', 'Lỗi kết nối', 'Không thể kết nối đến máy chủ.');
      return false;
    }
  }

  async function fetchSettings() {
    try {
      const res = await fetch('/api/settings');
      const result = await res.json();
      if (res.ok && result.success) {
        currentSiteSettings = result.data || {};
        currentHeroBanners = currentSiteSettings.heroBanners || [];
        renderSingleBannerForm(currentBannerIndex);

        const contact = currentSiteSettings.contact || {};
        document.getElementById('cfgContactPhone').value = contact.phone || '';
        document.getElementById('cfgContactEmail').value = contact.email || '';
        document.getElementById('cfgContactTime').value = contact.time || '';
        document.getElementById('cfgContactAddress1').value = contact.address1 || '';
        document.getElementById('cfgContactAddress2').value = contact.address2 || '';

        const social = currentSiteSettings.social || {};
        document.getElementById('cfgSocialZalo').value = social.zalo || '';
        document.getElementById('cfgSocialMessenger').value = social.messenger || '';
        document.getElementById('cfgSocialFacebook').value = social.facebook || '';
        document.getElementById('cfgSocialInstagram').value = social.instagram || '';
        document.getElementById('cfgSocialTiktok').value = social.tiktok || '';

        const footer = currentSiteSettings.footer || {};
        document.getElementById('cfgFooterAbout').value = footer.aboutText || '';
        document.getElementById('cfgFooterCopyright').value = footer.copyright || '';
      }
    } catch (err) {
      console.error('Lỗi khi lấy cấu hình CMS:', err);
    }
  }

  async function saveSettings(e) {
    if (e) e.preventDefault();
    await saveSettingsInternal(true);
    renderSingleBannerForm(currentBannerIndex);
  }

  fetchBooks().then(() => {
    populateRevenueFilterDropdowns();
  });
  fetchInvoices().then(() => {
    populateRevenueFilterDropdowns();
  });
  fetchStaff();
  fetchSettings();

  document.getElementById('invoiceSearchInput')?.addEventListener('input', filterAdminInvoices);
  document.getElementById('invoiceStatusFilter')?.addEventListener('change', filterAdminInvoices);

  // Lắng nghe thay đổi bộ lọc doanh thu tự động
  document.getElementById('revStartDate')?.addEventListener('change', applyRevenueFilter);
  document.getElementById('revEndDate')?.addEventListener('change', applyRevenueFilter);
  document.getElementById('revAuthorFilter')?.addEventListener('change', applyRevenueFilter);
  document.getElementById('revBookFilter')?.addEventListener('change', applyRevenueFilter);
  document.getElementById('revCategoryFilter')?.addEventListener('change', applyRevenueFilter);
  document.getElementById('revPaymentFilter')?.addEventListener('change', applyRevenueFilter);
  document.getElementById('revStatusFilter')?.addEventListener('change', applyRevenueFilter);

  // ============ TAB SWITCHING ============
  const tabButtons = document.querySelectorAll('.side-nav button[data-tab]');
  const panels = document.querySelectorAll('.tab-panel');

  function goToTab(tabName){
    tabButtons.forEach(b => b.classList.toggle('active', b.dataset.tab === tabName));
    panels.forEach(p => p.classList.toggle('active', p.id === 'tab-' + tabName));
    window.scrollTo({ top:0, behavior:'smooth' });
  }
  tabButtons.forEach(btn => btn.addEventListener('click', () => goToTab(btn.dataset.tab)));
  document.querySelectorAll('[data-goto]').forEach(el => {
    el.addEventListener('click', (e) => { e.preventDefault(); goToTab(el.dataset.goto); });
  });

  // ============ LOGOUT ============
  document.getElementById('logoutBtn').addEventListener('click', async () => {
    if(await showCustomConfirm('Bạn có chắc muốn đăng xuất khỏi tài khoản quản trị?')){
      try {
        const response = await fetch('/api/auth/logout', { method: 'POST' });
        if (response.ok) {
          window.location.href = '/';
        } else {
          showCustomToast('error', 'Đăng xuất thất bại', 'Vui lòng thử lại.');
        }
      } catch (error) {
        console.error('Lỗi đăng xuất:', error);
        window.location.href = '/';
      }
    }
  });
</script>

</body>
</html>
