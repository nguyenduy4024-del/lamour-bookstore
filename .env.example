PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/lamour_bookstore
JWT_SECRET=lamour_secret_key_2026_very_secure
NODE_ENV=development

# SMTP GMAIL CONFIGURATION (Hoạt động tốt trên Localhost / VPS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="L'Amour Bookstore <your_email@gmail.com>"

# HTTP EMAIL API (BẮT BUỘC KHI TRIỂN KHAI TRÊN RENDER CLOUD GÓI FREE)
# Vì Render Free Tier chặn toàn bộ các cổng SMTP 25, 465, 587, bạn chỉ cần chọn 1 trong các dịch vụ HTTP sau:
# 1. Resend (Khuyên dùng - 100 mail/ngày miễn phí, đăng ký tại https://resend.com):
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM="L'Amour Bookstore <onboarding@resend.dev>"

# 2. Brevo / Sendinblue (300 mail/ngày miễn phí, đăng ký tại https://brevo.com):
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx

# 3. SendGrid (100 mail/ngày miễn phí):
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx

# 4. Mailgun:
# MAILGUN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=sandbox-xxx.mailgun.org